#!/bin/bash

set -euo pipefail

source ~/.bashrc

# Verify virt1 is running before snapshotting
VM_READY=$(kubectl get vm virt1 -n default -o jsonpath='{.status.ready}' 2>/dev/null || echo "false")
if [ "$VM_READY" != "true" ]; then
  echo "WARNING: virt1 is not running — run the challenge 02 solve first"
fi

# --- VM Snapshot: virt1-snap1 ---
echo ">>> Creating snapshot 'virt1-snap1' of virt1..."
kubectl apply -f - << 'EOF'
apiVersion: snapshot.kubevirt.io/v1beta1
kind: VirtualMachineSnapshot
metadata:
  name: virt1-snap1
  namespace: default
spec:
  source:
    apiGroup: kubevirt.io
    kind: VirtualMachine
    name: virt1
EOF

echo ">>> Waiting for snapshot to be ready (up to 5 minutes)..."
for i in $(seq 1 30); do
  READY=$(kubectl get vmsnapshot virt1-snap1 -n default \
    -o jsonpath='{.status.readyToUse}' 2>/dev/null || echo "false")
  echo "  ReadyToUse: ${READY} (attempt ${i}/30)"
  [ "$READY" = "true" ] && break
  sleep 10
done

# --- Storage class: harvester-longhorn-2rep ---
echo ">>> Creating StorageClass 'harvester-longhorn-2rep' (2 replicas)..."
kubectl apply -f - << 'EOF'
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: harvester-longhorn-2rep
  annotations:
    storageclass.kubernetes.io/is-default-class: "false"
provisioner: driver.longhorn.io
allowVolumeExpansion: true
reclaimPolicy: Delete
volumeBindingMode: Immediate
parameters:
  numberOfReplicas: "2"
  staleReplicaTimeout: "30"
  fromBackup: ""
  fsType: ext4
EOF

echo ">>> Verifying resources..."
kubectl get vmsnapshot virt1-snap1 -n default 2>/dev/null && echo "  virt1-snap1 OK" || echo "  WARNING: snapshot not found"
kubectl get storageclass harvester-longhorn-2rep 2>/dev/null && echo "  harvester-longhorn-2rep OK" || echo "  WARNING: StorageClass not found"

echo ">>> Challenge 04 solve complete."
