#!/bin/bash
# Challenge 6 setup — pre-provisions the "already running in production" VM
# this chapter's story assumes exists before the student arrives:
#   core-services   (the VM that gets snapshotted, wiped, and restored)
#
# core-services was previously referenced nowhere else in the track —
# no chapter created it, confirmed via a live `kubectl get vm -A` that showed
# only webserver-prod pre-baked on the cluster. This script closes that gap.
#
# Boots from the SLES15-SP7 Minimal VM image (official-images), same
# convention as daily-batch-processor (chapter 4) — SSH user `sles`.
# Deliberately does NOT install/start the QEMU guest agent: task 1's own note
# says the snapshot here is crash-consistent by design, and the guest agent
# is introduced later (chapter 8) for contrast. Don't add it here.
#
# Field shapes and known gotchas match chapter 4's setup-kvm-host exactly
# (both scripts provision a VM the same way) — see that script's header and
# [[reference-harvester-crd-schemas]] for the full live-verified breakdown:
#   - bridge interface, LiveMigrateIfPossible, per-image storageClassName
#     read from status at runtime, SSH key embedded directly via
#     ssh_authorized_keys (the sshNames annotation is a no-op against inline
#     cloudInitNoCloud.userData — confirmed live via vertex-trader-01).
#
# Idempotent (kubectl apply) and non-fatal, matching the other chapter setup
# scripts' convention: a failure here should never block the track, but the
# chapter will be unworkable until this succeeds at least once.
#
# KNOWN RISK from the old image, now resolved: the SLES cloud-image family
# (confirmed via chapter 3's pre-baked SLES-16 image and vertex-trader-01) is
# cloud-init-first and honors NoCloud static network-data correctly.
#   - Namespace: placed in prod by pattern-match with webserver-prod (both
#     are "core production systems" in the story) — not independently
#     verified since core-services never existed on the cluster before.
#
# FIXED 2026-07-17: this used to wait up to 10 minutes for the staged image
# (only created by chapter 3, task 1) and silently skip VM creation if it
# never showed up, which breaks a live workshop jumping straight to chapter
# 6+. Now self-provisions the same image (matched by URL) if missing.
#
# FIXED 2026-07-20/21 then REPLACED 2026-07-21: same story as chapter 4's
# setup-kvm-host (see its header for the full breakdown) — disk-0's PVC size
# of 5Gi failed against the (then) openSUSE Leap Micro image's 32GiB
# virtualSize, and pinning replicas to 1 still wasn't enough since this lab's
# 3 nodes don't have 32GiB+ free each. Switched to SLES15-SP7-Minimal-VM;
# disk-0 is back to 5Gi accordingly.

set -uo pipefail
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

NS="prod"
NET="${NS}/service"
IMAGE_NS="official-images"
SSH_PUBKEY_FILE="/root/.ssh/id_rsa.pub"
VM_NAME="core-services"
VM_IP="192.168.122.53"

log(){ echo ">>> [ch6-setup] $*"; }

log "waiting for namespace ${NS} ..."
for _ in $(seq 1 60); do
  kubectl get namespace "${NS}" &>/dev/null && break
  sleep 5
done
kubectl get namespace "${NS}" &>/dev/null || { log "warn: namespace ${NS} never appeared (non-fatal, but chapter 6 will fail)."; }

log "waiting for VM network ${NET} ..."
for _ in $(seq 1 60); do
  kubectl get network-attachment-definitions.k8s.cni.cncf.io -n "${NS}" service &>/dev/null && break
  sleep 5
done

log "waiting for SSH keypair ${SSH_PUBKEY_FILE} (generated by track setup) ..."
for _ in $(seq 1 30); do
  [ -f "${SSH_PUBKEY_FILE}" ] && break
  sleep 5
done
if [ ! -f "${SSH_PUBKEY_FILE}" ]; then
  log "warn: no SSH public key found; ${VM_NAME} will come up without student SSH access."
  SSH_PUBKEY=""
else
  SSH_PUBKEY="$(cat "${SSH_PUBKEY_FILE}")"
fi

IMAGE_URL="http://192.168.122.1:8889/SLES15-SP7-Minimal-VM.x86_64-Cloud-GM.qcow2"
IMAGE_DISPLAY_NAME="SLES15-SP7-Minimal-VM.x86_64-Cloud-GM.qcow2"

find_image() {
  kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.url}{"\n"}{end}' 2>/dev/null \
    | grep -F "${IMAGE_URL}" | awk '{print $1}' | head -n1
}

log "checking for SLES15-SP7 Minimal VM image in ${IMAGE_NS} ..."
IMAGE_NAME="$(find_image)"

if [ -z "${IMAGE_NAME}" ]; then
  log "not found (chapter 3 task 1 likely skipped) — creating it directly ..."
  cat <<EOF | kubectl create -f -
apiVersion: harvesterhci.io/v1beta1
kind: VirtualMachineImage
metadata:
  generateName: image-
  namespace: ${IMAGE_NS}
spec:
  sourceType: download
  displayName: ${IMAGE_DISPLAY_NAME}
  url: ${IMAGE_URL}
  storageClassParameters:
    numberOfReplicas: "1"
EOF
  sleep 5
  IMAGE_NAME="$(find_image)"
fi

log "waiting for image ${IMAGE_NS}/${IMAGE_NAME:-<pending>} to become Active (up to 10 minutes) ..."
READY=""
for _ in $(seq 1 60); do
  [ -z "${IMAGE_NAME}" ] && IMAGE_NAME="$(find_image)"
  if [ -n "${IMAGE_NAME}" ]; then
    READY="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${IMAGE_NAME}" \
      -o jsonpath='{.status.progress}' 2>/dev/null)"
    [ "${READY}" = "100" ] && break
  fi
  sleep 10
done

if [ -z "${IMAGE_NAME}" ] || [ "${READY:-}" != "100" ]; then
  log "warn: image still not Active after waiting. Skipping VM creation."
  echo ">>> Challenge 6 setup complete (${VM_NAME} NOT created — image not ready)."
  exit 0
fi
log "using image ${IMAGE_NS}/${IMAGE_NAME}"

IMAGE_SC="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${IMAGE_NAME}" \
  -o jsonpath='{.status.storageClassName}' 2>/dev/null)"
[ -n "${IMAGE_SC}" ] || { log "warn: could not read storageClassName for ${IMAGE_NS}/${IMAGE_NAME}; VM creation will likely fail."; }

if kubectl get vm -n "${NS}" "${VM_NAME}" &>/dev/null; then
  log "${VM_NAME} already exists, skipping creation."
else
  log "creating ${VM_NAME} at ${VM_IP} ..."
  cat <<EOF | kubectl apply -f -
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: ${VM_NAME}
  namespace: ${NS}
  labels:
    stage: prod
  annotations:
    harvesterhci.io/volumeClaimTemplates: |-
      [{"metadata":{"name":"${VM_NAME}-disk-0","annotations":{"harvesterhci.io/imageId":"${IMAGE_NS}/${IMAGE_NAME}"}},"spec":{"accessModes":["ReadWriteMany"],"resources":{"requests":{"storage":"5Gi"}},"volumeMode":"Block","storageClassName":"${IMAGE_SC}"}}]
spec:
  runStrategy: Always
  template:
    metadata:
      labels:
        harvesterhci.io/vmName: ${VM_NAME}
    spec:
      hostname: ${VM_NAME}
      evictionStrategy: LiveMigrateIfPossible
      domain:
        cpu:
          cores: 2
          sockets: 1
          threads: 1
        resources:
          requests:
            cpu: "2"
            memory: 2Gi
          limits:
            cpu: "2"
            memory: 2Gi
        machine:
          type: q35
        devices:
          disks:
          - name: disk-0
            bootOrder: 1
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            model: virtio
            bridge: {}
      networks:
      - name: default
        multus:
          networkName: ${NET}
      volumes:
      - name: disk-0
        persistentVolumeClaim:
          claimName: ${VM_NAME}-disk-0
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            hostname: ${VM_NAME}
            ssh_authorized_keys:
              - ${SSH_PUBKEY}
            chpasswd:
              expire: False
              list: |
                root:\$6\$SalTsaLt\$Yb2OtGlwV37.96VyXUSa9nGMfpWm40YAkJx1yQRZgIFF.Waoay8p5fMPx5c7XFOTXpOjoT/AfANAAEeNc58oF/
                sles:\$6\$SalTsaLt\$Yb2OtGlwV37.96VyXUSa9nGMfpWm40YAkJx1yQRZgIFF.Waoay8p5fMPx5c7XFOTXpOjoT/AfANAAEeNc58oF/
          networkData: |
            version: 2
            ethernets:
              eth0:
                addresses:
                  - ${VM_IP}/24
                gateway4: 192.168.122.1
                nameservers:
                  addresses:
                    - 192.168.122.1
EOF
fi

log "waiting for ${VM_NAME} to reach Running phase ..."
for _ in $(seq 1 60); do
  PHASE="$(kubectl get vmi -n "${NS}" "${VM_NAME}" -o jsonpath='{.status.phase}' 2>/dev/null)"
  [ "${PHASE}" = "Running" ] && { log "${VM_NAME}: Running"; break; }
  sleep 10
done
[ "${PHASE:-}" = "Running" ] || log "warn: ${VM_NAME} not Running yet (non-fatal, check the UI)."

echo ">>> Challenge 6 setup complete."
exit 0
