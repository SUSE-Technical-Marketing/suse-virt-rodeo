#!/bin/bash

set -euo pipefail

source ~/.bashrc

export KUBECONFIG=/root/.kube/harvester.yaml

# Wait for Harvester API (should already be up from track setup)
echo ">>> Verifying Harvester API..."
until curl -sk --max-time 5 "https://192.168.122.10/v1" &>/dev/null; do
  echo "Waiting for Harvester API..."
  sleep 5
done

# Wait for Rancher — diagnostic version to understand why it times out.
echo ">>> Waiting for Rancher..."
echo ">>> Checking network connectivity to Rancher VM (192.168.122.9)..."
ping -c 3 -W 2 192.168.122.9 2>&1 | tail -3 || echo "  ping failed"

echo ">>> Checking port 30002..."
curl -sk --max-time 5 -o /dev/null -w "HTTP %{http_code} (connect: %{time_connect}s)\n" \
  "https://192.168.122.9:30002/" 2>&1 || echo "  port 30002 unreachable"

echo ">>> /ping endpoint:"
curl -sk --max-time 5 "https://192.168.122.9:30002/ping" 2>&1 || echo "  no response"

echo ">>> /v3 endpoint (first 200 chars):"
curl -sk --max-time 5 "https://192.168.122.9:30002/v3" 2>&1 | head -c 200 || echo "  no response"

echo ">>> Starting wait loop (up to 45 minutes)..."
ELAPSED=0
MAX_WAIT=2700
until curl -sk --max-time 5 "https://192.168.122.9:30002/ping" 2>/dev/null | grep -q "pong"; do
  sleep 10
  ELAPSED=$((ELAPSED + 10))
  if [[ $ELAPSED -ge $MAX_WAIT ]]; then
    echo "ERROR: Timed out waiting for Rancher after ${ELAPSED}s"
    echo ">>> Final diagnostics:"
    ping -c 1 -W 2 192.168.122.9 2>&1 | tail -1 || true
    curl -sk --max-time 5 -o /dev/null -w "HTTP %{http_code}\n" "https://192.168.122.9:30002/" 2>&1 || true
    curl -sk --max-time 5 "https://192.168.122.9:30002/ping" 2>&1 || true
    curl -sk --max-time 5 "https://192.168.122.9:30002/v3" 2>&1 | head -c 200 || true
    exit 1
  fi
  if [[ $((ELAPSED % 60)) -eq 0 ]]; then
    RESP=$(curl -sk --max-time 5 "https://192.168.122.9:30002/ping" 2>/dev/null || echo "(no response)")
    echo ">>> ${ELAPSED}s — /ping: ${RESP}"
  fi
done
echo ">>> Rancher /ping responded — verifying /v3..."
until curl -sk --max-time 5 "https://192.168.122.9:30002/v3" 2>/dev/null | grep -q '"type"'; do
  sleep 5
done
echo ">>> Rancher is up"

RANCHER_PASS=$(agent variable get RANCHER_PASSWORD)

RANCHER_TOKEN=$(curl -sk -X POST \
  "https://192.168.122.9:30002/v3-public/localProviders/local?action=login" \
  -H "Content-Type: application/json" \
  -d "{\"username\":\"admin\",\"password\":\"${RANCHER_PASS}\"}" \
  | python3 -c "import sys,json; print(json.load(sys.stdin).get('token',''))")

if [ -z "$RANCHER_TOKEN" ] || [ "$RANCHER_TOKEN" = "null" ]; then
  echo "ERROR: Failed to get Rancher token"
  exit 1
fi

agent variable set RANCHER_TOKEN "$RANCHER_TOKEN"

# Update Rancher server-url so login redirects go through the Instruqt service tab.
if [ -n "${_SANDBOX_DNS:-}" ]; then
  RANCHER_PROXY_URL="https://kvm-host-30002.${_SANDBOX_DNS}"
  curl -sk -X PUT \
    -H "Authorization: Bearer ${RANCHER_TOKEN}" \
    -H "Content-Type: application/json" \
    "https://192.168.122.9:30002/v3/settings/server-url" \
    -d "{\"value\": \"${RANCHER_PROXY_URL}\"}" >/dev/null 2>&1 \
    && echo ">>> Rancher server-url → ${RANCHER_PROXY_URL}" \
    || echo ">>> WARNING: server-url update failed (non-fatal)"
fi

echo ">>> Challenge 00 ready — Harvester and Rancher APIs are up."
