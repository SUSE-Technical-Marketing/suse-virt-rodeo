#!/bin/bash

set -euo pipefail

source ~/.bashrc

# Verify the backends are reachable before the student starts
echo ">>> Verifying Harvester and Rancher are reachable..."
until curl -sk --max-time 5 "https://geekohive:8443/v1" &>/dev/null; do
  echo "Waiting for Harvester API..."
  sleep 5
done
until curl -sk --max-time 5 "https://geekohive:30002/v3" &>/dev/null; do
  echo "Waiting for Rancher API..."
  sleep 5
done

echo "Challenge 00 ready — Harvester and Rancher APIs are up."
