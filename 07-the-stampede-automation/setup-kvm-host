#!/bin/bash
set -uo pipefail
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

# package_update is deliberately left out (or false) here - it forces a full
# repo refresh before install and was the single biggest chunk of boot time
# for VMs built from this template, same fix already applied to chapters
# 3/4/6's cloud-init (see chapter 3's solve-kvm-host header for the original
# finding).
cat <<EOF | kubectl apply -f -
apiVersion: v1
data:
  cloudInit: |
    #cloud-config
    packages:
      - qemu-guest-agent
    runcmd:
      - - systemctl
        - enable
        - --now
        - qemu-guest-agent.service
    ssh_authorized_keys:
      - ssh-ed25519
        AAAAC3NzaC1lZDI1NTE5AAAAIFdt8wX4G0WGg/l4uDq/LntBO7WiNyqh0+pNUzF/NfMa
kind: ConfigMap
metadata:
  labels:
    harvesterhci.io/cloud-init-template: user
  name: prod
  namespace: prod
EOF

