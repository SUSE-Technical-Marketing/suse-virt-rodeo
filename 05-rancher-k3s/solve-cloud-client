#!/bin/bash

set -euo pipefail

source ~/.bashrc

RANCHER_TOKEN=$(agent variable get RANCHER_TOKEN)
RANCHER_URL=$(agent variable get RANCHER_URL)

# If checkin-cluster already exists and is active, just download the kubeconfig
CLUSTER_STATE=$(curl -sk \
  -H "Authorization: Bearer $RANCHER_TOKEN" \
  "${RANCHER_URL}/v3/clusters?name=checkin-cluster" \
  | jq -r '.data[0].state // empty')

if [ "$CLUSTER_STATE" = "active" ]; then
  echo ">>> checkin-cluster is already Active. Downloading kubeconfig..."
  CLUSTER_ID=$(curl -sk \
    -H "Authorization: Bearer $RANCHER_TOKEN" \
    "${RANCHER_URL}/v3/clusters?name=checkin-cluster" \
    | jq -r '.data[0].id')

  mkdir -p /root/.kube
  curl -sk -X POST \
    -H "Authorization: Bearer $RANCHER_TOKEN" \
    "${RANCHER_URL}/v3/clusters/${CLUSTER_ID}?action=generateKubeconfig" \
    | jq -r .config > /root/.kube/checkin-cluster.yaml

  echo ">>> Kubeconfig saved to /root/.kube/checkin-cluster.yaml"
  exit 0
fi

# --- Create cloud credential for Harvester ---
echo ">>> Getting Harvester cluster ID..."
HARV_CLUSTER_ID=$(curl -sk \
  -H "Authorization: Bearer $RANCHER_TOKEN" \
  "${RANCHER_URL}/v3/clusters?name=harvester" \
  | jq -r '.data[0].id')

if [ -z "$HARV_CLUSTER_ID" ] || [ "$HARV_CLUSTER_ID" = "null" ]; then
  echo "ERROR: Harvester cluster not found — complete challenge 00 (import) first"
  exit 1
fi

# Get the Harvester cluster kubeconfig for the cloud credential
echo ">>> Generating Harvester kubeconfig for cloud credential..."
HARV_KUBECONFIG=$(curl -sk -X POST \
  -H "Authorization: Bearer $RANCHER_TOKEN" \
  "${RANCHER_URL}/v3/clusters/${HARV_CLUSTER_ID}?action=generateKubeconfig" \
  | jq -r '.config')

HARV_KUBECONFIG_B64=$(echo "$HARV_KUBECONFIG" | base64 -w 0)

# Check if cloud credential already exists
CRED_EXISTS=$(curl -sk \
  -H "Authorization: Bearer $RANCHER_TOKEN" \
  "${RANCHER_URL}/v3/cloudcredentials" \
  | jq -r '.data[] | select(.name=="harvester-local") | .id // empty')

if [ -z "$CRED_EXISTS" ]; then
  echo ">>> Creating cloud credential 'harvester-local'..."
  curl -sk -X POST \
    -H "Authorization: Bearer $RANCHER_TOKEN" \
    -H "Content-Type: application/json" \
    "${RANCHER_URL}/v3/cloudcredentials" \
    -d "{
      \"type\": \"credential\",
      \"name\": \"harvester-local\",
      \"harvestercredentialConfig\": {
        \"clusterType\": \"imported\",
        \"clusterId\": \"${HARV_CLUSTER_ID}\",
        \"kubeConfig\": \"${HARV_KUBECONFIG}\"
      }
    }" > /dev/null
  echo ">>> Cloud credential created."
fi

# Cluster provisioning via Rancher's v1 provisioning API requires a complex
# node driver config. The UI steps are required for the full cluster provisioning.
# This solve script handles the cloud credential and kubeconfig download only.
cat << 'MSG'

MANUAL STEPS REQUIRED FOR THIS CHALLENGE:

The checkin-cluster provisioning must be completed through the Rancher UI:
1. Go to Cluster Management > Create > RKE2/K3s > Harvester
2. Cluster name: checkin-cluster
3. Cloud credential: harvester-local
4. Node pool: 1 node, 2 CPU, 4 GiB RAM, 40 GiB disk, image: default/leap16, network: default/vmnet
5. Add-ons: enable Harvester CSI Driver and Harvester Cloud Provider
6. Click Create and wait for Active (~10 minutes)

Then run this solve script again to download the kubeconfig.
MSG

exit 0
