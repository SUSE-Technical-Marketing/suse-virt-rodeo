#!/bin/bash
# Challenge 3 check — verifies tasks 1-5 (state-changing tasks) of
# the-flash-crash-first-vm. Tasks 6-7 are UI/manual SSH validation with
# nothing new to check beyond what tasks 2-5 already establish (Running VM,
# correct volumes, correct IP).
#
# API-based only (no actual SSH into the VM), matching the pattern used by
# chapters 1 and 2's check scripts.

set -uo pipefail
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

NS="prod"
IMAGE_NS="official-images"
VM_NAME="algo-trader-01"
VM_IP="192.168.122.50"

FAIL=0
fail(){ echo "FAIL: $*"; FAIL=1; }

# --- Task 1: openSUSE Leap Micro image -------------------------------------
LEAP_URL="http://192.168.122.1:8889/openSUSE-Leap-Micro.x86_64-Default-qcow.qcow2"
LEAP_IMAGE_NAME="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
  -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.url}{"\n"}{end}' 2>/dev/null \
  | grep -F "${LEAP_URL}" | awk '{print $1}' | head -n1)"
if [ -n "${LEAP_IMAGE_NAME}" ]; then
  PROGRESS="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${LEAP_IMAGE_NAME}" \
    -o jsonpath='{.status.progress}' 2>/dev/null)"
  [ "${PROGRESS}" = "100" ] || fail "openSUSE Leap Micro image found but not Active yet (progress=${PROGRESS:-0})."
else
  fail "openSUSE Leap Micro image not found in ${IMAGE_NS}."
fi

# --- Tasks 2-5: algo-trader-01 VM ------------------------------------------
if ! kubectl get vm -n "${NS}" "${VM_NAME}" &>/dev/null; then
  fail "VirtualMachine ${VM_NAME} not found in ${NS}."
else
  CORES="$(kubectl get vm -n "${NS}" "${VM_NAME}" -o jsonpath='{.spec.template.spec.domain.cpu.cores}' 2>/dev/null)"
  [ "${CORES}" = "2" ] || fail "${VM_NAME} has ${CORES:-?} CPU cores, expected 2."

  MEM="$(kubectl get vm -n "${NS}" "${VM_NAME}" -o jsonpath='{.spec.template.spec.domain.resources.requests.memory}' 2>/dev/null)"
  [ "${MEM}" = "2Gi" ] || fail "${VM_NAME} memory request is '${MEM:-empty}', expected 2Gi."

  STAGE_LABEL="$(kubectl get vm -n "${NS}" "${VM_NAME}" -o jsonpath='{.metadata.labels.stage}' 2>/dev/null)"
  [ "${STAGE_LABEL}" = "prod" ] || fail "${VM_NAME} label stage='${STAGE_LABEL:-empty}', expected 'prod'."

  SSHNAMES="$(kubectl get vm -n "${NS}" "${VM_NAME}" -o jsonpath='{.spec.template.metadata.annotations.harvesterhci\.io/sshNames}' 2>/dev/null)"
  echo "${SSHNAMES}" | grep -q "prod/default" || fail "${VM_NAME} sshNames annotation is '${SSHNAMES:-empty}', expected to include prod/default."

  NETNAME="$(kubectl get vm -n "${NS}" "${VM_NAME}" -o jsonpath='{.spec.template.spec.networks[0].multus.networkName}' 2>/dev/null)"
  [ "${NETNAME}" = "${NS}/service" ] || fail "${VM_NAME} network is '${NETNAME:-empty}', expected ${NS}/service."

  NODE_KEY="$(kubectl get vm -n "${NS}" "${VM_NAME}" \
    -o jsonpath='{.spec.template.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[0].key}' 2>/dev/null)"
  NODE_VAL="$(kubectl get vm -n "${NS}" "${VM_NAME}" \
    -o jsonpath='{.spec.template.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[0].values[0]}' 2>/dev/null)"
  [ "${NODE_KEY}" = "stage" ] && [ "${NODE_VAL}" = "prod" ] || fail "${VM_NAME} node scheduling rule is '${NODE_KEY:-empty}=${NODE_VAL:-empty}', expected stage=prod."

  VOL_COUNT="$(kubectl get vm -n "${NS}" "${VM_NAME}" -o jsonpath='{.spec.template.spec.volumes}' 2>/dev/null | grep -o 'persistentVolumeClaim' | wc -l | tr -d ' ')"
  [ "${VOL_COUNT}" -ge 2 ] || fail "${VM_NAME} has ${VOL_COUNT} PVC-backed volumes, expected at least 2 (boot disk + market-data-vol)."

  kubectl get pvc -n "${NS}" "${VM_NAME}-market-data-vol" &>/dev/null || fail "PVC ${VM_NAME}-market-data-vol not found."

  PHASE="$(kubectl get vmi -n "${NS}" "${VM_NAME}" -o jsonpath='{.status.phase}' 2>/dev/null)"
  [ "${PHASE}" = "Running" ] || fail "${VM_NAME} VMI phase is '${PHASE:-empty}', expected Running."

  VMI_IP="$(kubectl get vmi -n "${NS}" "${VM_NAME}" -o jsonpath='{.status.interfaces[0].ipAddress}' 2>/dev/null)"
  [ "${VMI_IP}" = "${VM_IP}" ] || fail "${VM_NAME} reports IP '${VMI_IP:-empty}', expected ${VM_IP}."
fi

if [[ "${FAIL}" -eq 1 ]]; then
  exit 1
fi

echo "PASS: Chapter 3 objectives verified (Leap Micro image, algo-trader-01 running at ${VM_IP} with 2 volumes)"
