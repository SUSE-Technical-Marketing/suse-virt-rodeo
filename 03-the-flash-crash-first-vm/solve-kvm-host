#!/bin/bash
# Challenge 3 solve — reproduces tasks 1-5 of the-flash-crash-first-vm (tasks 6-7
# are UI console watching + manual SSH validation, nothing to create for them).
#
# Creates, in order:
#   Task 1 - VirtualMachineImage openSUSE-Leap-Micro (ns official-images)
#   Tasks 2-5 - VirtualMachine algo-trader-01 (ns prod): 2 CPU/2GiB, SSHKey
#     prod/default, label stage=prod, boot disk 5GiB from the SLES image +
#     blank 1GiB market-data-vol, network prod/service, static IP .50,
#     nodeAffinity stage=prod
#
# Idempotent (kubectl apply / pre-existence checks). Fails loudly (set -e).
#
# Built from a live dump of the pre-baked webserver-prod VM in this same
# cluster (2026-07-15) — that VM's real manifest is the source of truth for
# every field shape below, not guesswork:
#   - Interface type is `bridge: {}`, NOT `masquerade: {}`.
#   - evictionStrategy is `LiveMigrateIfPossible`, NOT `LiveMigrate`.
#   - SSH key injection is the annotation `harvesterhci.io/sshNames:
#     '["prod/default"]'` on spec.template.metadata — no need to read/embed
#     the KeyPair's public key manually.
#   - Node scheduling rules compile to spec.template.spec.affinity.nodeAffinity
#     .requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms, not a
#     flat nodeSelector map.
#   - volumeClaimTemplates annotation: imageId is "<ns>/<image-resource-name>";
#     storageClassName is a per-image generated value (`lh-<uuid>`) — READ
#     from the image's own status.storageClassName at runtime, never
#     hardcoded/guessed (confirmed this differs per image; my first ch4
#     attempt guessed `longhorn-<name>` and that was wrong).
#   - The SLES boot image is already present on this cluster:
#     official-images/image-v62vf, storageClassName
#     lh-3311febd-12d9-4ebc-82bc-728e5ccbfbe6 (confirmed live, but still
#     looked up dynamically below rather than hardcoded, in case the image
#     gets rebuilt with a new resource name).
#
# Cloud Config Template 'prod/prod' referenced in the assignment text does
# NOT exist anywhere on the cluster (confirmed: no matching secret in ns
# prod). Per Andres, this script inlines cloud-init directly on the VM
# instead of trying to create/reference that unverified object.
#
# KNOWN RISK — not yet live-tested:
#   - market-data-vol is a BLANK 1GiB volume (not cloned from any image). Its
#     volumeClaimTemplates entry omits the imageId annotation and uses the
#     generic `harvester-longhorn` storage class (the targetStorageClassName
#     every image resolves to before Harvester generates its per-image
#     lh-<uuid> variant) — this exact combination (no imageId => blank disk)
#     is inferred, not confirmed against a live blank-volume VM.
#   - Whether providing a minimal custom cloudInitNoCloud.userData (just a
#     hostname) still lets the sshNames annotation's mutating webhook inject
#     the SSH key correctly, or whether it needs to be left empty/omitted.

set -euo pipefail
export KUBECONFIG=/root/.kube/harvester.yaml

NS="prod"
IMAGE_NS="official-images"
VM_NAME="algo-trader-01"
VM_IP="192.168.122.50"

log(){ echo ">>> [ch3-solve] $*"; }

# --- Task 1: openSUSE Leap Micro image ------------------------------------
LEAP_URL="https://pkg.adfinis.com/opensuse/distribution/leap-micro/6.2/appliances/openSUSE-Leap-Micro.x86_64-Default-qcow.qcow2"
LEAP_DISPLAY="openSUSE-Leap-Micro.x86_64-Default-qcow.qcow2"

log "checking for existing ${LEAP_DISPLAY} image ..."
LEAP_IMAGE_NAME="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
  -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.url}{"\n"}{end}' 2>/dev/null \
  | grep -F "${LEAP_URL}" | awk '{print $1}' | head -n1 || true)"

if [ -n "${LEAP_IMAGE_NAME}" ]; then
  log "already exists: ${IMAGE_NS}/${LEAP_IMAGE_NAME}"
else
  log "creating ${LEAP_DISPLAY} ..."
  kubectl create -f - <<EOF
apiVersion: harvesterhci.io/v1beta1
kind: VirtualMachineImage
metadata:
  generateName: image-
  namespace: ${IMAGE_NS}
  labels:
    harvesterhci.io/imageDisplayName: ${LEAP_DISPLAY}
spec:
  sourceType: download
  displayName: ${LEAP_DISPLAY}
  url: ${LEAP_URL}
  targetStorageClassName: harvester-longhorn
EOF
fi

log "waiting for ${LEAP_DISPLAY} to reach 100% (this downloads server-side, can take a couple of minutes) ..."
for _ in $(seq 1 60); do
  LEAP_IMAGE_NAME="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.url}{"\n"}{end}' 2>/dev/null \
    | grep -F "${LEAP_URL}" | awk '{print $1}' | head -n1 || true)"
  [ -n "${LEAP_IMAGE_NAME}" ] || { sleep 10; continue; }
  PROGRESS="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${LEAP_IMAGE_NAME}" \
    -o jsonpath='{.status.progress}' 2>/dev/null || true)"
  [ "${PROGRESS}" = "100" ] && { log "${LEAP_DISPLAY} ready (${IMAGE_NS}/${LEAP_IMAGE_NAME})"; break; }
  sleep 10
done
[ "${PROGRESS:-0}" = "100" ] || { echo "ERROR: ${LEAP_DISPLAY} did not finish downloading in time."; exit 1; }

# --- Tasks 2-5: algo-trader-01 VM ------------------------------------------
log "looking up SLES boot image (official-images, displayName SLES-16.0-Minimal-VM.x86_64-Cloud-GM.qcow2) ..."
SLES_IMAGE_NAME="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
  -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.displayName}{"\n"}{end}' 2>/dev/null \
  | grep -F "SLES-16.0-Minimal-VM.x86_64-Cloud-GM.qcow2" | awk '{print $1}' | head -n1 || true)"
[ -n "${SLES_IMAGE_NAME}" ] || { echo "ERROR: SLES boot image not found in ${IMAGE_NS}. Has task 1's base image been imported?"; exit 1; }

SLES_SC="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${SLES_IMAGE_NAME}" \
  -o jsonpath='{.status.storageClassName}' 2>/dev/null)"
[ -n "${SLES_SC}" ] || { echo "ERROR: could not read storageClassName for ${IMAGE_NS}/${SLES_IMAGE_NAME}."; exit 1; }
log "using boot image ${IMAGE_NS}/${SLES_IMAGE_NAME} (storageClass ${SLES_SC})"

if kubectl get vm -n "${NS}" "${VM_NAME}" &>/dev/null; then
  log "${VM_NAME} already exists, skipping creation."
else
  log "creating ${VM_NAME} ..."
  cat <<EOF | kubectl apply -f -
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: ${VM_NAME}
  namespace: ${NS}
  labels:
    stage: prod
    harvesterhci.io/os: linux
  annotations:
    harvesterhci.io/volumeClaimTemplates: |-
      [{"metadata":{"name":"${VM_NAME}-disk-0","annotations":{"harvesterhci.io/imageId":"${IMAGE_NS}/${SLES_IMAGE_NAME}"}},"spec":{"accessModes":["ReadWriteMany"],"resources":{"requests":{"storage":"5Gi"}},"volumeMode":"Block","storageClassName":"${SLES_SC}"}},{"metadata":{"name":"${VM_NAME}-market-data-vol"},"spec":{"accessModes":["ReadWriteMany"],"resources":{"requests":{"storage":"1Gi"}},"volumeMode":"Block","storageClassName":"harvester-longhorn"}}]
spec:
  runStrategy: Always
  template:
    metadata:
      annotations:
        harvesterhci.io/sshNames: '["prod/default"]'
      labels:
        harvesterhci.io/vmName: ${VM_NAME}
    spec:
      hostname: ${VM_NAME}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: stage
                operator: In
                values:
                - prod
      evictionStrategy: LiveMigrateIfPossible
      domain:
        cpu:
          cores: 2
          sockets: 1
          threads: 1
        machine:
          type: q35
        resources:
          requests:
            cpu: "2"
            memory: 2Gi
          limits:
            cpu: "2"
            memory: 2Gi
        devices:
          disks:
          - name: disk-0
            bootOrder: 1
            disk:
              bus: virtio
          - name: market-data-vol
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            model: virtio
            bridge: {}
      networks:
      - name: default
        multus:
          networkName: ${NS}/service
      volumes:
      - name: disk-0
        persistentVolumeClaim:
          claimName: ${VM_NAME}-disk-0
      - name: market-data-vol
        persistentVolumeClaim:
          claimName: ${VM_NAME}-market-data-vol
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            hostname: ${VM_NAME}
          networkData: |
            version: 2
            ethernets:
              enp1s0:
                addresses:
                  - ${VM_IP}/24
                gateway4: 192.168.122.1
                nameservers:
                  addresses:
                    - 192.168.122.1
EOF
fi

log "waiting for ${VM_NAME} to reach Running phase ..."
for _ in $(seq 1 60); do
  PHASE="$(kubectl get vmi -n "${NS}" "${VM_NAME}" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  [ "${PHASE}" = "Running" ] && { log "${VM_NAME}: Running"; break; }
  sleep 10
done
[ "${PHASE:-}" = "Running" ] || { echo "ERROR: ${VM_NAME} did not reach Running in time."; exit 1; }

echo "PASS: Chapter 3 objectives created (Leap Micro image, algo-trader-01 running at ${VM_IP})"
