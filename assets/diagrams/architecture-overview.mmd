graph LR
    subgraph BROWSER["🖥️  Student Browser"]
        direction TB
        T1["Harvester UI\ntab :90"]
        T2["Rancher UI\ntab :91"]
        T3["AeroGrid NOC\ntab :92"]
    end

    subgraph SANDBOX["☁️  Instruqt Sandbox"]
        direction TB

        subgraph CC["cloud-client container"]
            direction TB
            NGX["nginx reverse proxy\n:90 → Harvester UI\n:91 → Rancher UI\n:92 → NOC (port-forward)"]
            KCT["kubectl  ·  Harvester via Rancher proxy"]
        end

        subgraph GH["geekohive   32 vCPU · 90 GB · SLES 16 · 950 GB SSD"]
            direction TB
            DNAT["firewalld port-forward\n:8443 → VIP 192.168.122.10:443  ·  :30002 → 192.168.122.9:30002"]

            subgraph VIRBR["virbr0  —  192.168.122.0/24  (libvirt NAT)"]
                direction TB
                VIP["kube-vip floating VIP\n192.168.122.10  (moves to a live node)"]
                RN["rancher  ·  192.168.122.9\n4 vCPU  ·  12 GiB  ·  60 GB\nK3s  +  Rancher Prime 2.13.1\neth0: management"]

                subgraph HVC["Harvester 1.8.0  —  3-node HA cluster"]
                    direction LR
                    H1["harvester1\n192.168.122.11\n8 vCPU · 20 GiB · 270 GB\neth0 mgmt  eth1 storage\neth2 migration\neth3 svc1  eth4 svc2"]
                    H2["harvester2\n192.168.122.12\n8 vCPU · 20 GiB · 270 GB\neth0 mgmt  eth1 storage\neth2 migration\neth3 svc1  eth4 svc2"]
                    H3["harvester3\n192.168.122.13\n8 vCPU · 20 GiB · 270 GB\neth0 mgmt  eth1 storage\neth2 migration\neth3 svc1  eth4 svc2"]
                end
            end
        end
    end

    T1 -->|"port 90"| NGX
    T2 -->|"port 91"| NGX
    T3 -->|"port 92"| NGX
    NGX -->|"https :8443"| DNAT
    NGX -->|"https :30002"| DNAT
    DNAT -->|"DNAT"| H1
    DNAT -->|"DNAT"| RN
    KCT -.->|"API"| RN
    RN -->|"Virtualization\nManagement"| H1
    H1 <-->|"etcd / Kube-OVN"| H2
    H2 <-->|"etcd / Kube-OVN"| H3
    H1 <-->|"etcd / Kube-OVN"| H3

    classDef harvester fill:#1B3D6F,stroke:#30BA78,color:#fff
    classDef rancher fill:#2058A8,stroke:#30BA78,color:#fff
    classDef nginx fill:#163355,stroke:#6EC6A0,color:#fff
    classDef dnat fill:#3D1F00,stroke:#FFA500,color:#FFD080
    classDef kubectl fill:#0C2340,stroke:#6EC6A0,color:#adf
    classDef tab fill:#1A4A2E,stroke:#30BA78,color:#fff

    class H1,H2,H3 harvester
    class RN rancher
    class NGX nginx
    class DNAT dnat
    class KCT kubectl
    class T1,T2,T3 tab
