  log "Starting Harvester..."
  # This command can be confusing, we are SSHing in to the harvester1 GCP instance and then starting the 
  # 3 harvester cluster nodes which are virtual machines running in the instance
  # Retry a few times, it can fail if VM isnt ready.
  # Note that the VM names are hard coded here


  try "gcloud compute ssh ${HARVESTER_INSTANCE_NAME} \
  --zone=${zones[0]} \
  --command='sudo virsh list --all'" wait=15 retry=2


gcloud compute ssh "${HARVESTER_INSTANCE_NAME}" \
  --zone="${zones[0]}" -- bash <<'EOF'
sudo virsh setmaxmem harvester1 16G --config
sudo virsh setmem harvester1 16G --config
sudo virsh start harvester1
sudo virsh setmaxmem harvester2 16G --config
sudo virsh setmem harvester2 16G --config
sudo virsh start harvester2
sudo virsh setmaxmem harvester3 16G --config
sudo virsh setmem harvester3 16G --config
sudo virsh start harvester3
sudo virsh start util3
EOF

 
  # Create firewall rule using the collected IPs
  try "gcloud compute firewall-rules create harvester-allow \
    --direction=INGRESS \
    --priority=1000 \
    --network=default \
    --action=ALLOW \
    --rules=all \
    --source-ranges=0.0.0.0/0" wait=15 retry=2


  log "Capturing NAT IP for HARVESTER"
  max_retries=60
  wait_seconds=5
  # Regex pattern for validating IPv4
  ip_regex='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
  for ((i=1; i<=max_retries; i++)); do
    try "HARVESTER_NAT_IP=$(gcloud compute instances describe ${HARVESTER_INSTANCE_NAME} --zone=${zones[0]} --format='get(networkInterfaces[0].accessConfigs[0].natIP)')" 

    if [[ $HARVESTER_NAT_IP =~ $ip_regex ]]; then
      log "External IP found: $HARVESTER_NAT_IP"
      break
    fi

    log "Waiting for External IP... (${i}/${max_retries})"
    sleep $wait_seconds
  done

  # Final check to fail if still empty
  if [[ ! $HARVESTER_NAT_IP =~ $ip_regex ]]; then
    terminate "Timed out waiting for external IP"
  fi


  logv2 "Installing virtctl"
  #export VERSION=$(curl https://storage.googleapis.com/kubevirt-prow/release/kubevirt/kubevirt/stable.txt)
  export VERSION=v1.4.0
  wget --quiet https://github.com/kubevirt/kubevirt/releases/download/${VERSION}/virtctl-${VERSION}-linux-amd64
  mv virtctl-${VERSION}-linux-amd64 /usr/local/bin/virtctl
  chmod +x /usr/local/bin/virtctl

  add_bashrc "export HARVESTER_NAT_IP=${HARVESTER_NAT_IP}"

  logv2 "Creating Harvester" phase="END"

  gcp_create_harvester_ran=true


}

