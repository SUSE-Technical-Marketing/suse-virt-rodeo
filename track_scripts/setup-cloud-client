ocp_oauth_validate () {
  
  logv2 "ocp_oauth_validate" phase="START" 

  TIMEOUT=300  # 5 minutes
  INTERVAL=15  # 15 seconds per attempt
  ELAPSED=0

  # Loop to test the bearer token multiple times
  log "Waiting for OpenShift API to be fully available..."
  while [[ $ELAPSED -lt $TIMEOUT ]]; do
      #login to the oauth idp using local auth to obtain a token
      oc login --server=https://api.ocp.${OCP_DNS_ZONE}:6443 -u admin -p Password1

      # Test OAuth token authentication
      HTTP_STATUS=$(curl -k -s -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $(oc whoami --show-token)" \
          https://oauth-openshift.apps.ocp.${OCP_DNS_ZONE})

      # Test API server by checking projects
      PROJECTS_OUTPUT=$(oc get projects 2>&1)
      API_ERROR=$(echo "$PROJECTS_OUTPUT" | grep -c "server is currently unable to handle the request")

      if [[ "$HTTP_STATUS" == "200" && "$API_ERROR" -eq 0 ]]; then
          log "OAuth token validated and API server is ready!"
          break
      else
          log"OAuth/API validation failed (HTTP: $HTTP_STATUS, API Error: $API_ERROR). Retrying in $INTERVAL seconds..."
      fi

      sleep "$INTERVAL"
      ELAPSED=$((ELAPSED + INTERVAL))
  done

  if [[ "$ELAPSED" -ge "$TIMEOUT" ]]; then
      echo "ERROR: OAuth token did not validate successfully within $TIMEOUT seconds!"
      exit 1
  fi

  logv2 "ocp_oauth_validate" phase="END"
  ocp_oauth_validate=true
}


ocp_config_local_IDP() {
### This function is designed to run AFTER openshift is installed to setup a local username and password 

  if [[ $ocp_config_local_IDP_ran == true ]]; then
    log "${FUNCNAME[0]} has already run, skipping"
    return 0
  fi

  logv2 "Configuring OCP Local IDP" phase="START"

# Setup local auth
cat << EOF > htpasswd-cr.yaml
apiVersion: config.openshift.io/v1
kind: OAuth
metadata:
  name: cluster
spec:
  identityProviders:
  - name: localIDP 
    mappingMethod: claim 
    type: HTPasswd
    htpasswd:
      fileData:
        name: htpass-secret
EOF
  # Set the Password
  htpasswd -c -B -b users.htpasswd admin Password1
  #Apply the secret with the Password in it
  oc create secret generic htpass-secret --from-file=htpasswd=users.htpasswd -n openshift-config
  
  log "Waiting for OAuth pod to get new IDP Config..."

  # Get all existing OAuth pods BEFORE applying the configuration
  OLD_PODS=($(kubectl get pods -n openshift-authentication -l app=oauth-openshift -o jsonpath="{.items[*].metadata.name}"))
  log "The original openshift-authentication pod was : ${OLD_PODS[@]}"

  # Apply the new Identity Provider configuration
  try "oc apply -f htpasswd-cr.yaml" wait=5 retry=5

  INTERVAL=15
  TIMEOUT=600
  ELAPSED=0 #init

  # Wait for a new pod to be created (OAuth pod restart)
  log "Waiting for a new OAuth pod to appear..."
  NEW_OAUTH_DETECTED="false"

  while [[ "$ELAPSED" -lt "$TIMEOUT" ]]; do
      # Get the current list of OAuth pods
      CURRENT_PODS=($(kubectl get pods -n openshift-authentication -l app=oauth-openshift -o jsonpath="{.items[*].metadata.name}"))

      for NEW_POD in "${CURRENT_PODS[@]}"; do
          if [[ ! " ${OLD_PODS[@]} " =~ " ${NEW_POD} " ]]; then
              log "Detected new OAuth pod: $NEW_POD"
              NEW_OAUTH_DETECTED="true"
              break 2  # Exit both loops (for & while)
          fi
      done

      log "Still waiting for OAuth pod to restart..."
      sleep $INTERVAL
      ELAPSED=$((ELAPSED + INTERVAL))
  done

  if [[ "$NEW_OAUTH_DETECTED" != "true" ]]; then
      log "ERROR: No new OAuth pod was created within timeout!"
      kubectl get pods -n openshift-authentication
      exit 1
  fi

  # Wait for the new OAuth pod to become Ready
  log "Waiting for all OAuth pods to be Ready..."
  ELAPSED=0

  while [[ "$ELAPSED" -lt "$TIMEOUT" ]]; do
      READY_PODS=$(kubectl get pods -n openshift-authentication -l app=oauth-openshift -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep -c "True")
      TOTAL_PODS=$(kubectl get pods -n openshift-authentication -l app=oauth-openshift --no-headers | wc -l)

      if [[ "$READY_PODS" -eq "$TOTAL_PODS" && "$TOTAL_PODS" -gt 0 ]]; then
          echo "All OAuth pods are Ready!"
          break
      fi

      echo "OAuth pods are not ready yet. Waiting..."
      kubectl get pods -n openshift-authentication

      sleep "$INTERVAL"
      ELAPSED=$((ELAPSED + INTERVAL))
  done

  if [[ "$ELAPSED" -ge "$TIMEOUT" ]]; then
      log "ERROR: Some OAuth pods did not become Ready within the timeout ($TIMEOUT seconds)"
      kubectl get pods -n openshift-authentication
      exit 1
  fi

  log "OAuth IDP configuration successfully applied."

  # apply policy to user
  oc adm policy add-cluster-role-to-user cluster-admin admin

  logv2 "Configuring OCP Local IDP" phase="END"

  ocp_config_localIDP=true

}

