    --rules=all \
    --source-ranges="$IP_NODE01/32,$IP_NODE02/32,$IP_NODE03/32" \
    --target-tags=allow-all-from-util2-rw" wait=15 retry=2

  try "gcloud compute instances add-tags $FASIM_INSTANCE_NAME \
  --zone=${zones[0]} \
  --tags=allow-all-from-util2-rw"  wait=15 retry=2

  log "Capturing NAT IP for FASIM"
  max_retries=60
  wait_seconds=5
  # Regex pattern for validating IPv4
  ip_regex='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
  for ((i=1; i<=max_retries; i++)); do
    try "FASIM_NAT_IP=$(gcloud compute instances describe ${FASIM_INSTANCE_NAME} --zone=${zones[0]} --format='get(networkInterfaces[0].accessConfigs[0].natIP)')" 

    if [[ $FASIM_NAT_IP =~ $ip_regex ]]; then
      log "External IP found: $FASIM_NAT_IP"
      break
    fi

    log "Waiting for External IP... (${i}/${max_retries})"
    sleep $wait_seconds
  done

  # Final check to fail if still empty
  if [[ ! $FASIM_NAT_IP =~ $ip_regex ]]; then
    terminate "Timed out waiting for external IP"
  fi

  # give nat IP to Util2
  # We actually dont use this in util 2, we point at $FASIM_UI_DNS_NAME
  # which points at the Ingress External IP. Then ingress services point at
  # the NAT address. This command here is just in case we need this info on 
  # util2 for some reason, or we can safeuly remove the two below lines.
  # $FASIM_NAT_IP is still used in the FASIM Ingress YAML.
  ssh -o StrictHostKeyChecking=no root@util2 "echo '$FASIM_NAT_IP' > /root/fasim_external_ip.txt"
  add_bashrc "export FASIM_NAT_IP=${FASIM_NAT_IP}"



  logv2 "Creating FASIM" phase="END"

  gcp_create_fasim_ran=true

}

