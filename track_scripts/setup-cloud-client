#!/bin/bash

set -euo pipefail

# Wait for Instruqt host bootstrap to finish
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  sleep 2
done

echo ">>> Waiting for Harvester cluster to be ready..."
until agent variable get RANCHER_TOKEN 2>/dev/null | grep -qv '^$'; do
  sleep 10
done

RANCHER_TOKEN=$(agent variable get RANCHER_TOKEN)
RANCHER_URL=$(agent variable get RANCHER_URL)
RANCHER_PASSWORD=$(agent variable get RANCHER_PASSWORD)

# Configure nginx on cloud-client to proxy UI tabs through the Instruqt service proxy.
#
# How Instruqt UI access works:
#   Student browser → Instruqt proxy → cloud-client:{90,91} → nginx → geekohive:{8443,30002}
#
# Instruqt acts as a transparent HTTPS proxy in front of cloud-client. nginx must:
#   1. Tell the backends (Harvester, Rancher) that the external connection is HTTPS
#      via X-Forwarded-Proto, so they generate correct redirect URLs.
#   2. Rewrite Location headers in backend redirects (e.g. login redirects) from
#      the internal backend URL to a path-relative URL so the browser stays on the
#      Instruqt proxy and does not try to connect to the internal IP directly.
#   3. Strip X-Frame-Options and Content-Security-Policy headers that would block
#      the Instruqt proxy from displaying the UI in its frame.
#   4. Pass WebSocket upgrade headers for live UI updates.
#
# Port 90 -> Harvester UI (geekohive:8443)
# Port 91 -> Rancher UI   (geekohive:30002)
cat > /etc/nginx/conf.d/harvester-proxy.conf << 'NGINXEOF'
server {
    listen 90;
    location / {
        proxy_pass              https://geekohive:8443;
        proxy_ssl_verify        off;
        proxy_buffering         off;
        proxy_http_version      1.1;

        # Tell Harvester the real scheme/host so it generates correct URLs
        proxy_set_header        Host                $http_host;
        proxy_set_header        X-Real-IP           $remote_addr;
        proxy_set_header        X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto   https;
        proxy_set_header        X-Forwarded-Host    $http_host;
        proxy_set_header        X-Forwarded-Port    443;

        # WebSocket support for live UI events
        proxy_set_header        Upgrade             $http_upgrade;
        proxy_set_header        Connection          "upgrade";
        proxy_read_timeout      3600s;

        # Rewrite Location headers in backend redirects so the browser follows
        # them through the Instruqt proxy (not directly to the internal IP)
        proxy_redirect          https://geekohive:8443/ $scheme://$http_host/;

        # Strip headers that would block the UI from loading in the Instruqt frame
        proxy_hide_header       X-Frame-Options;
        proxy_hide_header       Content-Security-Policy;
    }
}
server {
    listen 91;
    location / {
        proxy_pass              https://geekohive:30002;
        proxy_ssl_verify        off;
        proxy_buffering         off;
        proxy_http_version      1.1;

        # Tell Rancher the real scheme/host so it generates correct redirect URLs
        proxy_set_header        Host                $http_host;
        proxy_set_header        X-Real-IP           $remote_addr;
        proxy_set_header        X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto   https;
        proxy_set_header        X-Forwarded-Host    $http_host;
        proxy_set_header        X-Forwarded-Port    443;

        # WebSocket support for live UI events
        proxy_set_header        Upgrade             $http_upgrade;
        proxy_set_header        Connection          "upgrade";
        proxy_read_timeout      3600s;

        # Rewrite Location headers in backend redirects so login flows and
        # auth callbacks stay on the Instruqt proxy URL
        proxy_redirect          https://geekohive:30002/ $scheme://$http_host/;

        # Strip headers that would block the UI from loading in the Instruqt frame
        proxy_hide_header       X-Frame-Options;
        proxy_hide_header       Content-Security-Policy;
    }
}
NGINXEOF

nginx -s reload 2>/dev/null || nginx
echo ">>> nginx proxy configured (ports 90/91)"

# --- aerogrid.com DNS / named HTTPS vhosts ----------------------------------
#
# Resolve geekohive's address via the Instruqt internal DNS, then map the lab
# domain names to it so students can use names instead of IP:port combos.
# nginx listens on port 443 with a self-signed wildcard cert for *.aerogrid.com
# and routes by Host header to the right backend port on geekohive.
#
#   virtualization.aerogrid.com:443  → geekohive:8443  (Harvester VIP proxy)
#   rancher.aerogrid.com:443         → geekohive:30002 (Rancher Prime)
#
GEEKOHIVE_IP=$(getent hosts geekohive | awk '{print $1}')
if [ -z "${GEEKOHIVE_IP}" ]; then
  echo ">>> WARNING: could not resolve geekohive — aerogrid.com DNS entries skipped"
else
  # Write /etc/hosts so all CLI tools resolve the lab names
  grep -q "aerogrid.com" /etc/hosts && \
    sed -i '/aerogrid\.com/d' /etc/hosts
  cat >> /etc/hosts << HOSTSEOF
${GEEKOHIVE_IP} virtualization.aerogrid.com
${GEEKOHIVE_IP} rancher.aerogrid.com
${GEEKOHIVE_IP} alpha.aerogrid.com
${GEEKOHIVE_IP} bravo.aerogrid.com
${GEEKOHIVE_IP} charlie.aerogrid.com
HOSTSEOF
  echo ">>> /etc/hosts: aerogrid.com entries → ${GEEKOHIVE_IP}"
fi

# Self-signed wildcard cert for *.aerogrid.com (lab-grade, students use -k / accept)
CERT_DIR="/etc/ssl/aerogrid"
mkdir -p "${CERT_DIR}"
if [ ! -f "${CERT_DIR}/tls.crt" ]; then
  openssl req -x509 -newkey rsa:2048 \
    -keyout "${CERT_DIR}/tls.key" \
    -out    "${CERT_DIR}/tls.crt" \
    -days 3650 -nodes \
    -subj "/O=AeroGrid Operations/CN=aerogrid.com" \
    -addext "subjectAltName=DNS:aerogrid.com,DNS:*.aerogrid.com" \
    2>/dev/null
  echo ">>> TLS cert generated for *.aerogrid.com"
fi

# Named HTTPS vhosts on port 443
cat > /etc/nginx/conf.d/aerogrid-vhosts.conf << 'NGINXEOF'
server {
    listen 443 ssl;
    server_name virtualization.aerogrid.com;
    ssl_certificate     /etc/ssl/aerogrid/tls.crt;
    ssl_certificate_key /etc/ssl/aerogrid/tls.key;
    ssl_verify_client   off;

    location / {
        proxy_pass              https://geekohive:8443;
        proxy_ssl_verify        off;
        proxy_buffering         off;
        proxy_http_version      1.1;
        proxy_set_header        Host                $http_host;
        proxy_set_header        X-Real-IP           $remote_addr;
        proxy_set_header        X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto   https;
        proxy_set_header        X-Forwarded-Host    $http_host;
        proxy_set_header        X-Forwarded-Port    443;
        proxy_set_header        Upgrade             $http_upgrade;
        proxy_set_header        Connection          "upgrade";
        proxy_read_timeout      3600s;
        proxy_redirect          https://geekohive:8443/ $scheme://$http_host/;
        proxy_hide_header       X-Frame-Options;
        proxy_hide_header       Content-Security-Policy;
    }
}
server {
    listen 443 ssl;
    server_name rancher.aerogrid.com;
    ssl_certificate     /etc/ssl/aerogrid/tls.crt;
    ssl_certificate_key /etc/ssl/aerogrid/tls.key;
    ssl_verify_client   off;

    location / {
        proxy_pass              https://geekohive:30002;
        proxy_ssl_verify        off;
        proxy_buffering         off;
        proxy_http_version      1.1;
        proxy_set_header        Host                $http_host;
        proxy_set_header        X-Real-IP           $remote_addr;
        proxy_set_header        X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto   https;
        proxy_set_header        X-Forwarded-Host    $http_host;
        proxy_set_header        X-Forwarded-Port    443;
        proxy_set_header        Upgrade             $http_upgrade;
        proxy_set_header        Connection          "upgrade";
        proxy_read_timeout      3600s;
        proxy_redirect          https://geekohive:30002/ $scheme://$http_host/;
        proxy_hide_header       X-Frame-Options;
        proxy_hide_header       Content-Security-Policy;
    }
}
NGINXEOF

nginx -s reload 2>/dev/null || nginx
echo ">>> nginx: aerogrid.com named HTTPS vhosts active on port 443"

# Update Rancher's server-url so login redirects go back through the Instruqt proxy.
#
# When a student opens the Rancher UI tab, Instruqt proxies the request to
# cloud-client:91. Rancher must know the external URL the student sees so that
# login redirects (e.g. /auth/login → dashboard) land on the proxy URL and not
# on the unreachable internal IP (192.168.122.9:30002).
#
# Instruqt injects _SANDBOX_DNS with the sandbox-specific DNS suffix.
# Service tab URL format: https://<hostname>-<port>.<_SANDBOX_DNS>
if [ -n "${_SANDBOX_DNS:-}" ]; then
  RANCHER_PROXY_URL="https://cloud-client-91.${_SANDBOX_DNS}"
  UPDATE_RESULT=$(curl -sk -X PUT \
    -H "Authorization: Bearer ${RANCHER_TOKEN}" \
    -H "Content-Type: application/json" \
    "${RANCHER_URL}/v3/settings/server-url" \
    -d "{\"value\": \"${RANCHER_PROXY_URL}\"}" | jq -r '.value // empty' || echo "")
  if [ -n "${UPDATE_RESULT}" ]; then
    echo ">>> Rancher server-url → ${RANCHER_PROXY_URL}"
  else
    echo ">>> WARNING: Rancher server-url update failed — nginx proxy_redirect will handle redirects"
  fi
else
  echo ">>> _SANDBOX_DNS not set — skipping Rancher server-url update (nginx proxy_redirect active)"
fi

# Generate SSH key for VM access in later challenges.
# kubectl config and KeyPair registration happen in challenge 01 setup, after import.
if [ ! -f /root/.ssh/id_rsa ]; then
  ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N ""
fi

mkdir -p /root/.ssh
cat >> /root/.ssh/config << 'SSHEOF'

# virt1 lives on geekohive's internal KVM bridge (192.168.122.50).
# geekohive DNATs port 2222 → 192.168.122.50:22 so cloud-client can reach it.
# This entry must come before the Host virt* wildcard.
Host virt1
  HostName geekohive
  Port 2222
  User opensuse
  IdentityFile ~/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host virt*
  User opensuse
  IdentityFile ~/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
SSHEOF

echo ">>> cloud-client setup complete."
