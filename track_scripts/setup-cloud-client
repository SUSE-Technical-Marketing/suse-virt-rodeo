'      goog-ops-agent-policy: v2-x86-template-1-4-0' > config.yaml && \
  gcloud compute instances ops-agents policies create $POLICY_NAME \
    --zone=${zones[0]} \
    --file=config.yaml


  # Wait for VM to be RUNNING
  log "Waiting for VM '$HARVESTER_INSTANCE_NAME' to reach RUNNING state (timeout: 5 min)..."

  for ((i = 0; i < 60; i++)); do
    status=$(gcloud compute instances describe "$HARVESTER_INSTANCE_NAME" \
