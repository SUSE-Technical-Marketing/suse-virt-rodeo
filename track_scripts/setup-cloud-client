write_harvester_libvirt_firewall () {

  cat << 'EOF' > harvester-libvirt-firewall-hook.sh
#!/bin/bash
# Refactored for idempotency and safe reconnects

set -e
set -u

iptables='/sbin/iptables'

# Networking Discovery
WAN_IF="ens4"
WAN_IP=$(ip -4 addr show $WAN_IF | grep -oP '(?<=inet\s)\d+(\.\d+){3}' || echo "")
external_ifs="ens4 virbr0"
external_ip=$WAN_IP

# Machine definitions
machines=( 'harvester1' 'util3' )

harvester1_hostname='harvester1'
harvester1_ip='192.168.122.11'
harvester1_sport=( '8443' '8080' '6443' )
harvester1_dport=( '443' '80' '6443' )

util3_hostname='util3'
util3_ip='192.168.122.9'
util3_sport=( '7443' '7080' '9443' '30001' '30002' )
util3_dport=( '443' '80' '6443' '30001' '30002' )

# Static Rules
static_ips=( '192.168.122.21' '192.168.122.22' )
static_sports=( '2222' '2223' )
static_dports=( '22' '22' )

# Helper to run iptables without crashing on deletion errors
safe_iptables() {
    if [[ "$1" == *"-D"* ]]; then
        # Ignore errors during deletion to prevent script exit
        $iptables "$@" || true
    else
        $iptables "$@"
    fi
}

rules_update() {
    domain="$1"
    action="$2"

    # 1. Process Dynamic Machine Rules
    for host in "${machines[@]}"; do
        eval host_name="\$${host}_hostname"
        if [ "$domain" == "${host_name}" ]; then
            eval host_ip="\$${host}_ip"
            eval "host_sport=( \${${host}_sport[@]} )"
            eval "host_dport=( \${${host}_dport[@]} )"
            
            for i in "${!host_sport[@]}"; do
                for ext_if in ${external_ifs}; do
                    safe_iptables -t nat $action PREROUTING -d "${external_ip}" -i "${ext_if}" -p tcp --dport "${host_sport[$i]}" -j DNAT --to-destination "${host_ip}:${host_dport[$i]}"
                done
                safe_iptables $action FORWARD -d "${host_ip}" -p tcp -m state --state NEW --dport "${host_dport[$i]}" -j ACCEPT
            done
        fi
    done

    # 2. Process Static Rules
    # Logic: Only apply/remove static rules when ONE specific 'master' domain starts/stops 
    # OR if this is a general libvirtd restart. Change 'harvester1' to your primary VM.
    if [ "$domain" == "harvester1" ] || [ "$domain" == "GLOBAL" ]; then
        for i in "${!static_ips[@]}"; do
            for ext_if in ${external_ifs}; do
                safe_iptables -t nat $action PREROUTING -d "${external_ip}" -i "${ext_if}" -p tcp --dport "${static_sports[$i]}" -j DNAT --to-destination "${static_ips[$i]}:${static_dports[$i]}"
                safe_iptables $action FORWARD -d "${static_ips[$i]}" -p tcp -m state --state NEW --dport "${static_dports[$i]}" -j ACCEPT
            done
        done
    fi
}

domain_name="$1"
domain_task="$2"

case "${domain_task}" in
    start)
        rules_update "${domain_name}" "-I"
    ;;
    stopped)
        rules_update "${domain_name}" "-D"
    ;;
    reconnect)
        # Flush then Re-add
        rules_update "${domain_name}" "-D"
        rules_update "${domain_name}" "-I"
    ;;
esac
EOF

}

