config_custom_ca () {


  ### Configure a custom certificate authority
  # Ryan TODO as this looks like it is used for FASIM

  if [[ $config_custom_ca_ran == true ]]; then
    log "${FUNCNAME[0]} has already run, skipping"
    return 0
  fi

  logv2 "config_custom_ca" phase="START"

  # Set paths
  export CA_DIR=~/myCA
  export CONFIG_FILE="$CA_DIR/ca_openssl.cnf"
  export KEY_FILE="$CA_DIR/private/ca.key.pem"
  export CERT_FILE="$CA_DIR/certs/ca.cert.pem"

  # Create CA directory structure
  try "mkdir -p $CA_DIR/{certs,crl,newcerts,private}"
  try "chmod 700 $CA_DIR/private"
  try "touch $CA_DIR/index.txt"
  try "echo 1000 > $CA_DIR/serial"

  # Generate CA private key
  try "openssl genrsa -out $KEY_FILE 4096" wait=15 retry=2
  try "chmod 400 $KEY_FILE" wait=15 retry=2

  # Write the openssl config using a here-doc
  cat > "$CONFIG_FILE" <<EOF
[req]
distinguished_name = dn
x509_extensions = v3_ca
prompt = no

[dn]
C = US
ST = State
L = City
O = Portworx
OU = PXTME
CN = tme-internal.pxlab.io

[v3_ca]
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid:always,issuer
basicConstraints = critical,CA:true
keyUsage = critical,keyCertSign,cRLSign
EOF

  # Generate the CA certificate non-interactively
  try "openssl req -x509 -new -nodes -key $KEY_FILE -sha256 -days 3650 -out $CERT_FILE -config $CONFIG_FILE" wait=15 retry=2

  logv2 "Custom CA created at: $CERT_FILE"

  # scp it
  try "scp -o StrictHostKeyChecking=no ${CERT_FILE} root@util2:/root/custom-ca.crt" wait=15 retry=2
  # copy it locally and add it to cloud client
  try "cp ${CERT_FILE} /usr/local/share/ca-certificates/custom-ca.crt"
  update-ca-certificates
  #also for save keeping patch python certify used by PDS and add requests ca bundle
  cat /usr/local/share/ca-certificates/custom-ca.crt >> $(python3 -m certifi)
  add_bashrc "export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"

  config_custom_ca_ran=true

  logv2 "config_custom_ca" phase="END"
}

fasim_create_server_certs () {

  ### This function uses the internal CA to create certificates for FASIM resources.
  # The server certtificates are used in util2 and injected into the firefox
  # trusted certificates so that we can properly terminate SSL at the ingress
  # with trusted certificates in FireFox.

  if [[ $fasim_create_server_certs_ran == true ]]; then
    log "${FUNCNAME[0]} has already run, skipping"
    return 0
  fi

  logv2 "fasim_create_server_certs" phase="START"

  # PXD
  cat <<EOF > fasim-openssl.cnf
[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C = US
ST = State
L = City
O = Portworx
OU = PXTME
CN = ${FASIM_UI_DNS_NAME}

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = ${FASIM_UI_DNS_NAME}
EOF
  try "openssl ecparam -genkey -name prime256v1 -out fasim.key" wait=15 retry=2
  try 'openssl req -new -key fasim.key -out fasim.csr -config fasim-openssl.cnf' wait=15 retry=2
  try "openssl x509 -req -in fasim.csr -CA $CERT_FILE -CAkey $KEY_FILE -CAcreateserial -out fasim.crt -days 365 -sha256 -extfile fasim-openssl.cnf -extensions req_ext" wait=15 retry=2

  try 'kubectl create ns fasim' wait=15 retry=2
  try 'kubectl create secret tls fasim-tls --cert=fasim.crt --key=fasim.key -n fasim' wait=15 retry=2

  # PXBBQ
  cat <<EOF > pxbbq-openssl.cnf
[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C = US
ST = State
L = City
O = Portworx
OU = PXTME
CN = ${PX_CSI_PXBBQ_DNS_NAME}

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = ${PX_CSI_PXBBQ_DNS_NAME}
EOF
  try 'openssl ecparam -genkey -name prime256v1 -out pxbbq.key' wait=15 retry=2
  try 'openssl req -new -key pxbbq.key -out pxbbq.csr -config pxbbq-openssl.cnf' wait=15 retry=2
  try "openssl x509 -req -in pxbbq.csr -CA $CERT_FILE -CAkey $KEY_FILE  -CAcreateserial -out pxbbq.crt -days 365 -sha256 -extfile pxbbq-openssl.cnf -extensions req_ext" wait=15 retry=2

  try 'kubectl create ns pxbbq' wait=15 retry=2
  try 'kubectl create secret tls pxbbq-tls --cert=pxbbq.crt --key=pxbbq.key -n pxbbq' wait=15 retry=2

  cat << EOF > pxbbq-app-ingress.yaml
  # ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: pxbbq-ingress
  namespace: pxbbq
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - ${PX_CSI_PXBBQ_DNS_NAME}
      secretName: pxbbq-tls
  rules:
    - host: ${PX_CSI_PXBBQ_DNS_NAME}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: pxbbq-svc
                port:
                  number: 80
EOF

  cat <<EOF > fasim-ingress.yaml
# ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: fasim-ingress
  namespace: fasim
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/backend-protocol: "HTTPS"
    nginx.ingress.kubernetes.io/secure-backends: "true"
    nginx.ingress.kubernetes.io/ssl-services: "fasim-svc"
    nginx.ingress.kubernetes.io/proxy-ssl-verify: "off"
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - ${FASIM_UI_DNS_NAME}
      secretName: fasim-tls
  rules:
    - host: ${FASIM_UI_DNS_NAME}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: fasim-svc
                port:
                  number: 8443
---
apiVersion: v1
kind: Service
metadata:
  name: fasim-svc
  namespace: fasim
spec:
  ports:
    - protocol: TCP
      port: 8443
      targetPort: 8443
---
apiVersion: v1
kind: Endpoints
metadata:
  name: fasim-svc
  namespace: fasim
subsets:
  - addresses:
      - ip: ${FASIM_NAT_IP}
    ports:
      - port: 8443
EOF

  try 'kubectl create -f pxbbq-app-ingress.yaml' wait=15 retry=2
  try 'kubectl create -f fasim-ingress.yaml' wait=15 retry=2

  fasim_create_server_certs_ran=true

  logv2 "fasim_create_server_certs" phase="END"
}

fasim_config_dns () {

  ### This function configures the ROUTE53 DNS zones
  # for DNS endpoints in XXX.pxlab.io which makes
  # these resources accessible from our instruqt lab via public DNS

  if [[ $fasim_config_dns_ran == true ]]; then
    log "${FUNCNAME[0]} has already run, skipping"
    return 0
  fi

  logv2 "Configuring DNS for FASIM and apps" phase="START"
  log "resolving requirements"
  # Requires:
  aws_auth_configure

  # Regex pattern for validating IPv4
  ip_regex='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
  
  log "Getting Ingress External IP"
  max_retries=60
  wait_seconds=5
  for ((i=1; i<=max_retries; i++)); do
    try "INGRESS_EXT_IP=$(kubectl get svc ingress-nginx-controller -n ingress-nginx -o jsonpath='{.status.loadBalancer.ingress[0].ip}')" 

    if [[ $INGRESS_EXT_IP =~ $ip_regex ]]; then
      logv2 "External IP found: $INGRESS_EXT_IP"
      break
    fi

    logv2 "Waiting for External IP... (${i}/${max_retries})"
    sleep $wait_seconds
   done

   # Final check to fail if still empty
   if [[ ! $INGRESS_EXT_IP =~ $ip_regex ]]; then
     logv2 "Timed out waiting for external IP"
     terminate "Timed out waiting for external IP"
   fi
   
   add_bashrc "export INGRESS_EXT_IP=${INGRESS_EXT_IP}"

cat > change-resource-record-sets-pxcsi.json << EOF
{
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "${FASIM_UI_DNS_NAME}",
        "Type": "A",
        "TTL": 300,
        "ResourceRecords": [
          {
            "Value": "${INGRESS_EXT_IP}"
          }
        ]
      }
    },
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "${PX_CSI_PXBBQ_DNS_NAME}",
        "Type": "A",
        "TTL": 300,
        "ResourceRecords": [
          {
            "Value": "${INGRESS_EXT_IP}"
          }
        ]
      }
    }
  ]
}
EOF
  debug "$(cat change-resource-record-sets-pxcsi.json)"
  try "aws route53 change-resource-record-sets --hosted-zone-id $AWS_DNS_ZONE_ID --change-batch file://change-resource-record-sets-pxcsi.json"

  fasim_config_dns_ran=true

  logv2 "Configuring DNS for FASIM" phase="END"

}

