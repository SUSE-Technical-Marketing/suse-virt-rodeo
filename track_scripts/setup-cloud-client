                # Add MongoDB repository for version 7.0
                - "sudo sh -c 'echo \"[mongodb-org-7.0]\" > /etc/yum.repos.d/mongodb-org-7.0.repo'"
                - "sudo sh -c 'echo \"name=MongoDB Repository\" >> /etc/yum.repos.d/mongodb-org-7.0.repo'"
                - "sudo sh -c 'echo \"baseurl=https://repo.mongodb.org/yum/redhat/\\$releasever/mongodb-org/7.0/x86_64/\" >> /etc/yum.repos.d/mongodb-org-7.0.repo'"
                - "sudo sh -c 'echo \"gpgcheck=1\" >> /etc/yum.repos.d/mongodb-org-7.0.repo'"
                - "sudo sh -c 'echo \"enabled=1\" >> /etc/yum.repos.d/mongodb-org-7.0.repo'"
                - "sudo sh -c 'echo \"gpgkey=https://www.mongodb.org/static/pgp/server-7.0.asc\" >> /etc/yum.repos.d/mongodb-org-7.0.repo'"

