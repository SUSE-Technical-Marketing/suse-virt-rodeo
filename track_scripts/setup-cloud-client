log () {
  ### This function simply logs messages to STDOUT
  # It started by adding a timestamp (and still can) but by default is essentially echo
  # So why use it everywhere? It allows us to change the logging of the entire script from just this function
  # REMINDER: DO NOT LOG SECRETS
  local func=${FUNCNAME[1]}
  if [[ ${feature_LOG_TIMESTAMP} == true ]]; then
    echo $(date -u +"%Y-%m-%dT%H:%M:%SZ") "${func}:" "${@}"
  else 
    echo "${func}:" "${@}"
  fi
}

logv2 () {
  # Requires log
  # This adds a banner and CR to the end of the log. Use this at the beginning of functions.
  local log="${1}"
  shift
    while [[ "$1" != "" ]]; do
      PARAM=$(echo $1 | cut -d'=' -f1)
      VALUE=$(echo $1 | cut -d'=' -f2)
      case $PARAM in
        phase)
          local phase="${VALUE}"
          ;;
      esac
      shift
    done
    local func=${FUNCNAME[1]}
    local banner=${banner:-true}
    if [[ ${banner} == true ]]; then
      log ""
      log "########### ${phase} - ${func} - $(date -u +"%Y-%m-%dT%H:%M:%SZ") ###########"
    fi
    log "#### $log ####"
    log "######################"
}

debug () {
  ### Debug simply logs when the DEBUG flag is set. This allows us to have verbose messages
  if [[ ${DEBUG} == 1 ]]; then
    log "DEBUG: ${@}"
  fi
}


