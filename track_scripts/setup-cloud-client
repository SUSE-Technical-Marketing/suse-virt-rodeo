handle_missing_certificates_final_check() {
  
  logv2 "Handle Missing Certificates Final Check" phase="START"

  log "Checking Kubernetes Certificate Status..."
  if ocp_ssl_validate; then
      log "All certificates are present and ready. No further action needed."
      return
  fi

  log "Some certificates are missing or not ready. Taking corrective action"
  # Find the correct cert-manager pod (excluding cainjector & webhook)
  CERT_MANAGER_POD=$(kubectl get pods -n cert-manager --no-headers \
      | awk '/cert-manager-/ && !/cainjector/ && !/webhook/ {print $1; exit}')

  if [[ -z "$CERT_MANAGER_POD" ]]; then
      log "No valid cert-manager pod found! Manual intervention required."
      return 1
  fi

  log "Restarting cert-manager"
  kubectl delete pod "$CERT_MANAGER_POD" -n cert-manager
  sleep 10

  log "Waiting up to 5 minutes for certificates to become ready..."
  ATTEMPTS=0
  MAX_ATTEMPTS=15

  while [[ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]]; do
    sleep 20  # Wait 20 seconds
    log "Re-checking certificate readiness... (Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS)"
    
    if ocp_ssl_validate; then
        log "All certificates are now READY!"

        log "Ensuring OAuth pod has restarted with new certificates"
        OAUTH_POD=$(kubectl get pods -n openshift-authentication -l app=oauth-openshift -o jsonpath='{.items[0].metadata.name}')
        CERT_APPLIED_TIME=$(date -d "$(kubectl get certificates -A -o jsonpath='{.items[0].status.notAfter}')" +%s)
        OAUTH_START_TIME=$(date -d "$(kubectl get pod $OAUTH_POD -n openshift-authentication -o jsonpath='{.status.startTime}')" +%s)


        while [[ "$OAUTH_START_TIME" -lt "$CERT_APPLIED_TIME" ]]; do
            log "OAuth pod has NOT restarted after cert update. Retrying in 10s..."
            sleep 10
            OAUTH_START_TIME=$(date -d "$(kubectl get pod $OAUTH_POD -n openshift-authentication -o jsonpath='{.status.startTime}')" +%s)
        done

        log "OAuth pod has restarted AFTER certificate update!"

        # Wait for OAuth Pod to Be Ready
        log "Waiting for OAuth pod to be READY..."
        until [[ "$(kubectl get pods -n openshift-authentication -l app=oauth-openshift -o jsonpath='{.items[0].status.containerStatuses[0].ready}')" == "true" ]]; do
            log "OAuth pod is not ready yet. Retrying in 10s..."
            sleep 10
        done
        log "OAuth pod is READY!"
        return 0
    fi

    ((ATTEMPTS++))
  done
  
  log "Some certificates are still not ready. Manual intervention is needed"
  log "Fetching detailed status for '$CERT_NAME'..."
  kubectl describe certificate "$CERT_NAME" -n "$NAMESPACE"
  return 0  #FLIP to 1 when we're ready to implement. 0 will continue provisioning without certs.

}

ocp_ssl_validate_ORIG () {

  logv2 "ZeroSSL Certificate Request Status Check" phase="START"

  local MAX_ATTEMPTS=10
  local NEEDS_RECREATION=0  # Flag to track if any cert is missing
  CERT_DOMAINS=("api.ocp.$OCP_DNS_ZONE" '\*.'"$SANDBOX_ID"'.pxlab.io')

  logv2 "Checking for certificates: ${CERT_DOMAINS[*]}"

  # Function to check for the certificate
  check_certificate() {
    local SEARCH_DOMAIN="$1"

    log "Checking for certificate request for '$SEARCH_DOMAIN'..."

    # Make the API request
    RESPONSE=$(curl -s "https://api.zerossl.com/certificates?access_key=$ZEROSSL_APIKEY&search=$SEARCH_DOMAIN")
    if [[ -z "$RESPONSE" ]]; then
      log "API request failed or returned empty response for '$SEARCH_DOMAIN'."
      return 1
    fi

    # Check if the results array is empty
    CERT_COUNT=$(echo "$RESPONSE" | jq '.results | length')

    if [[ "$CERT_COUNT" -gt 0 ]]; then
      log "Certificate request found for '$SEARCH_DOMAIN'."
      echo "$RESPONSE" | jq '.results[] | {id, common_name, additional_domains, status, created, expires}'
      return 0  # Success
    else
      log "No certificate request found for '$SEARCH_DOMAIN'."
      return 1  # Failure
    fi
  }

  # Check each certificate
  for domain in "${CERT_DOMAINS[@]}"; do
    if ! check_certificate "$domain"; then
      log "No certificate request found in ZeroSSL for $domain."
      NEEDS_RECREATION=1  # Set flag if any cert is missing
    fi
  done

  # Recreate Kubernetes objects if any cert was missing
  if [[ "$NEEDS_RECREATION" -eq 1 ]]; then
    log "One or more certificates missing. Recreating Kubernetes objects."

    # Log challenges before deleting
    log "Logging All Challenge Statuses for Debugging"
    { kubectl get challenge -n openshift-config -o name; kubectl get challenge -n openshift-ingress -o name; } \
    | grep -E 'api-certs-zerossl|router-certs-zerossl' \
    | awk -F'/' '{print $2}' \
    | xargs -I {} sh -c 'kubectl describe challenge {} -n openshift-config || kubectl describe challenge {} -n openshift-ingress'

    # Recreate the certificate requests
    log "Re-Requesting certificates."
    try "kubectl delete -f ocp-cert-manager-certs.yaml # Delete existing certificates"
    sleep 30
    try "kubectl apply -f ocp-cert-manager-certs.yaml # Request certificates"
    sleep 30

    # Re-check after recreation
    for domain in "${CERT_DOMAINS[@]}"; do
      log "Re-checking for certificate after recreation for $domain..."
      for ((i=1; i<=MAX_ATTEMPTS; i++)); do
        log "Certificate re-check attempt $i of $MAX_ATTEMPTS for $domain..."
        if check_certificate "$domain"; then
          log "Certificate found after recreation for $domain!"
          break
        fi
        log "Still not found. Retrying in 30 seconds..."
        sleep 30
      done

      # Final failure message
      if ! check_certificate "$domain"; then
        log "Final attempt failed. No certificate found for $domain after $MAX_ATTEMPTS attempts."
      fi
    done
  else
    log "All certificates are present. No need for recreation."
  fi

  logv2 "ZeroSSL Certificate Request Status Check" phase="END"
}


