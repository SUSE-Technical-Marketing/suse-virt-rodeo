ocp_ssl_validate () {

  log "Checking Kubernetes Certificate Status..."
  MISSING_CERT=false

  # Define the certificates and namespaces
  CERTIFICATES=(
      "openshift-config api-certs-zerossl"
      "openshift-ingress router-certs-zerossl"
  )

  for CERT in "${CERTIFICATES[@]}"; do
      NAMESPACE=$(echo "$CERT" | awk '{print $1}')
      CERT_NAME=$(echo "$CERT" | awk '{print $2}')

      # Check if the certificate exists
      if ! kubectl get certificate "$CERT_NAME" -n "$NAMESPACE" &>/dev/null; then
          log "Certificate '$CERT_NAME' in namespace '$NAMESPACE' does NOT exist!"
          MISSING_CERT=true
          continue
      fi

      # Get the Ready status
      STATUS=$(kubectl get certificate "$CERT_NAME" -n "$NAMESPACE" --no-headers -o custom-columns="READY:.status.conditions[?(@.type=='Ready')].status")

      if [[ "$STATUS" == "True" ]]; then
          log "Certificate '$CERT_NAME' in namespace '$NAMESPACE' is READY=True."
      else
          log "Certificate '$CERT_NAME' in namespace '$NAMESPACE' is NOT READY!"
          MISSING_CERT=true
      fi
  done

  # Return appropriate exit code based on whether any certs were missing
  if [[ "$MISSING_CERT" == "true" ]]; then
      return 1  # Certificates are missing or not ready
  else
      return 0  # All certificates are ready
  fi
}

