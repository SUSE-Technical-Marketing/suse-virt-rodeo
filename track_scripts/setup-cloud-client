    fi
    sleep 5

    if [[ $i -eq 59 ]]; then
      log "Timed out waiting for VM to become RUNNING."
      terminate "Timed out waiting for VM to become RUNNING."
    fi
  done

  # Wait for policy compliance
  log "Waiting for policy '$POLICY_NAME' to become COMPLIANT (timeout: 5 min)..."

  for ((i = 0; i < 60; i++)); do
    state=$(gcloud compute os-config os-policy-assignment-reports list \
      --location=${zones[0]} \
      --filter="assignment_id=$POLICY_NAME AND instance=$HARVESTER_INSTANCE_NAME" \
      --format="json" | jq -r '.[0].summary_str')

    log "Compliance state: ${state:-UNKNOWN}"

    if [[ "$state" == "1/1 policies compliant" ]]; then
      logv2 "Policy '$POLICY_NAME' successfully applied and is compliant."
      break
    fi

    sleep 5

    if [[ $i -eq 59 ]]; then
      logv2 "Timed out waiting for policy '$POLICY_NAME' to become compliant."
      terminate "Timed out waiting for policy '$POLICY_NAME' to become compliant."
    fi
  done


  log "Policy is fully initialized."

