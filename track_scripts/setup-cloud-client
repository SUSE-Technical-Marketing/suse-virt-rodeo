ocp_osv_install () {
  ### This function installs the openshift virtualization

  if [[ $ocp_osv_install_ran == true ]]; then
    log "${FUNCNAME[0]} has already run, skipping"
    return 0
  fi

  logv2 "Installing and Configuring OpenShift Virtualization" phase="START"
  log "resolving requirements"
  ### Requirements

  logv2 "Installing OCP OpenShift Virtualization" phase="START"
  log "resolving requirements"
  ### Requires:
  write_ocp_osv
  osv_write_storageclasses

  # Add vmstorage storage classes
  try "oc apply -f osv/px-rwx-block-kubevirt.yaml"
  try "oc apply -f osv/px-cdi-scratch.yaml"
  try "oc apply -f osv/px-rwx-file-kubevirt.yaml"

  # Install the OSV Operator
  log "Installing the OpenShift Virt Operator"
  try 'oc apply -f osv/ocp-osv.yaml' wait=20 retry=10

  # Wait until the Operator is ready before moving on
  log "Waiting for KubeVirt Hyperconverged Operator to be ready..."
  INSTALLPLAN_NAME="" #Init the InstallPlan Name
  TIMEOUT=300  # 5 minutes
  INTERVAL=10  # Check every 10 seconds
  ELAPSED=0

  while [[ -z "$INSTALLPLAN_NAME" && $ELAPSED -lt $TIMEOUT ]]; do
      INSTALLPLAN_NAME=$(kubectl get installplan -n openshift-cnv --no-headers -o custom-columns=":metadata.name" | head -n 1)
      
      if [[ -n "$INSTALLPLAN_NAME" ]]; then
          log "InstallPlan found: $INSTALLPLAN_NAME"
          break
      fi

      log "Still waiting for InstallPlan..."
      sleep $INTERVAL
      ELAPSED=$((ELAPSED + INTERVAL))
  done

  # Approve the InstallPlan
  if [[ -z "$INSTALLPLAN_NAME" ]]; then
      log "ERROR: No InstallPlan was found within timeout!"
      exit 1
  else
      log "Approving InstallPlan: $INSTALLPLAN_NAME"
      kubectl patch installplan "$INSTALLPLAN_NAME" -n openshift-cnv --type=merge -p '{"spec":{"approved":true}}'
  fi

  log "Waiting for KubeVirt HCO Operator to be ready..."
  while [[ $ELAPSED -lt $TIMEOUT ]]; do
    OPERATOR_NAME=$(kubectl get csv -n openshift-cnv -o jsonpath='{.items[?(@.spec.displayName=="OpenShift Virtualization")].metadata.name}')

    if [[ -z "$OPERATOR_NAME" ]]; then
      log "ERROR: Operator not found in openshift-cnv namespace. Retrying..."
    else
      STATUS=$(kubectl get csv "$OPERATOR_NAME" -n openshift-cnv -o jsonpath='{.status.phase}')
      
      if [[ "$STATUS" == "Succeeded" ]]; then
        log "KubeVirt Hyperconverged Operator ($OPERATOR_NAME) is ready!"
        break
      fi

      log "Operator ($OPERATOR_NAME) status: $STATUS. Retrying in $INTERVAL seconds..."
    fi

    sleep $INTERVAL
    ELAPSED=$((ELAPSED + INTERVAL))
  done

  if [[ "$STATUS" != "Succeeded" ]]; then
    log "ERROR: Operator did not become ready within $TIMEOUT seconds."
    exit 1
  fi

  # Apply the Hyperconverged Object HCO
  try 'oc apply -f osv/ocp-osv-obj.yaml' wait=20 retry=10

  ocp_osv_install_ran=true
  logv2 "Installing and Configuring OpenShift Virtualization" phase="END"

}

