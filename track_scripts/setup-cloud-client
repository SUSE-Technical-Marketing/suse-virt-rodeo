  # Requires:
  portworx_install

  log "enable pxctl alias"
  alias pxctl="PX_POD=\$(kubectl get pods -l name=portworx -n portworx --field-selector=status.phase==Running | grep \"1/1\" | awk \"NR==1{print \$1}\") && kubectl exec \$PX_POD -n portworx -- /opt/pwx/bin/pxctl"
