                - "sudo sed -i 's/^  bindIp:.*$/  bindIp: 0.0.0.0/' /etc/mongod.conf"
                - sudo systemctl restart mongod

                # Wait for MongoDB to fully start
                - sleep 10

                # Create an admin user with mongosh
                - "/usr/bin/mongosh admin --eval \"db.createUser({user: 'porxie', pwd: 'porxie', roles:[{role: 'userAdminAnyDatabase', db: 'admin'}]})\""
