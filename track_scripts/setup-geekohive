#!/bin/bash

set -euo pipefail

LAB_DIR="/root/rodeo-lab"
RODEO=/usr/local/bin/rodeo   # symlinked from /opt/rodeo-venv/bin/rodeo at build time

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  sleep 2
done

echo ">>> Starting SUSE Virtualization KVM cluster..."

# Start VMs in definition order (harvester1 → harvester2 → harvester3 → rancher).
# rodeo start reads the lab definition for the correct start sequence and etcd gap.
"$RODEO" start --yes --all --config-dir "$LAB_DIR"

echo ">>> Waiting for Harvester nodes to join the cluster (up to 90 minutes)..."

export KUBECONFIG=/root/.kube/harvester.yaml

ELAPSED=0
MAX_WAIT=5400
until [ "$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready' || echo 0)" -ge 3 ]; do
  sleep 20
  ELAPSED=$((ELAPSED + 20))
  if [[ $ELAPSED -ge $MAX_WAIT ]]; then
    echo "ERROR: Timed out waiting for Harvester nodes after ${MAX_WAIT}s"
    virsh list --all
    exit 1
  fi
  if [[ $((ELAPSED % 120)) -eq 0 ]]; then
    READY=$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready' || echo 0)
    echo ">>> ${ELAPSED}s elapsed — ${READY}/3 nodes Ready"
  fi
done
echo ">>> All 3 Harvester nodes Ready"

echo ">>> Waiting for Rancher to become available (up to 30 minutes)..."
ELAPSED=0
MAX_WAIT=1800
until curl -sk --max-time 5 https://192.168.122.9:30002/v3 2>/dev/null | grep -q '"type":"collection"'; do
  sleep 10
  ELAPSED=$((ELAPSED + 10))
  if [[ $ELAPSED -ge $MAX_WAIT ]]; then
    echo "ERROR: Timed out waiting for Rancher after ${MAX_WAIT}s"
    exit 1
  fi
done
echo ">>> Rancher is up"

# Enable VM autostart now that the instance is live (skipped during image build
# because deployment_target: instruqt guards the finalise phase pre-snapshot).
echo ">>> Enabling VM autostart (finalise phase)..."
"$RODEO" deploy --finalise --no-tui --config-dir "$LAB_DIR"

if [ ! -f /root/rancher-password ]; then
  echo "ERROR: /root/rancher-password not found — was the builder run correctly?"
  exit 1
fi
RANCHER_PASS=$(cat /root/rancher-password)

RANCHER_TOKEN=$(curl -sk -X POST \
  "https://192.168.122.9:30002/v3-public/localProviders/local?action=login" \
  -H "Content-Type: application/json" \
  -d "{\"username\":\"admin\",\"password\":\"${RANCHER_PASS}\"}" \
  | python3 -c "import sys,json; print(json.load(sys.stdin).get('token',''))")

if [ -z "$RANCHER_TOKEN" ] || [ "$RANCHER_TOKEN" = "null" ]; then
  echo "ERROR: Failed to get Rancher token"
  exit 1
fi

agent variable set RANCHER_PASSWORD    "$RANCHER_PASS"
agent variable set RANCHER_TOKEN       "$RANCHER_TOKEN"
agent variable set RANCHER_URL         "https://geekohive:30002"
agent variable set HARVESTER_URL       "https://geekohive:8443"
agent variable set HARVESTER_NAT_IP    "geekohive"
agent variable set HARVESTER_PASSWORD  "$RANCHER_PASS"

echo ">>> Agent variables set. Setup complete."
