#!/bin/bash

set -euo pipefail

# The kvm-host image (config.yml) autostarts the nested VMs (harvester1-3 +
# rancher) via libvirt on boot. This script does not start them; it only waits
# for the cluster to come up and exports the agent variables the chapters use.
# Every wait below is a real bounded loop, not a fixed sleep — a new/untested
# image can boot at a different pace than the one this was last tuned for.

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  sleep 2
done

# Pre-cache the openSUSE Leap Micro image locally and serve it over HTTP on
# the virbr0 gateway (192.168.122.1 — this is kvm-host itself, already the
# gateway every nested VM's cloud-init points at, so it's reachable from
# harvester1-3 with no extra networking). Chapters 3/4/6 import from this
# local mirror instead of pulling ~1GB from the internet each time. Kicked
# off in the background here so the download runs in parallel with the
# Harvester node wait below — by the time any chapter needs it, it should
# already be cached.
#
# If the kvm-host image (built via rodeo-cli) ever bakes this file in ahead
# of time at ${IMAGE_CACHE_DIR}/${IMAGE_FILE}, the check below skips the
# download entirely and only starts the HTTP server — this script doesn't
# need to change either way.
IMAGE_CACHE_DIR="/var/www/images"
IMAGE_FILE="openSUSE-Leap-Micro.x86_64-Default-qcow.qcow2"
IMAGE_UPSTREAM_URL="https://pkg.adfinis.com/opensuse/distribution/leap-micro/6.2/appliances/${IMAGE_FILE}"
IMAGE_HTTP_PORT=8889
mkdir -p "${IMAGE_CACHE_DIR}"
(
  if [ ! -s "${IMAGE_CACHE_DIR}/${IMAGE_FILE}" ]; then
    echo ">>> [image-cache] downloading ${IMAGE_FILE} ..."
    curl -fsSL -o "${IMAGE_CACHE_DIR}/${IMAGE_FILE}.tmp" "${IMAGE_UPSTREAM_URL}" \
      && mv "${IMAGE_CACHE_DIR}/${IMAGE_FILE}.tmp" "${IMAGE_CACHE_DIR}/${IMAGE_FILE}" \
      && echo ">>> [image-cache] download complete." \
      || echo ">>> [image-cache] ERROR: download failed — chapters 3/4/6 image imports will fail until this is fixed and re-run manually."
  fi
) &> /var/log/image-cache.log &

if ! pgrep -f "http.server ${IMAGE_HTTP_PORT}" &>/dev/null; then
  setsid nohup python3 -m http.server "${IMAGE_HTTP_PORT}" --bind 192.168.122.1 --directory "${IMAGE_CACHE_DIR}" \
    < /dev/null &> /var/log/image-http-server.log &
  disown
fi

echo ">>> Waiting for Harvester VIP (192.168.122.10)..."
until curl -sk --max-time 5 "https://192.168.122.10" &>/dev/null; do
  sleep 5
done
echo ">>> Harvester VIP up."

echo ">>> Waiting for Harvester nodes (up to 90 minutes)..."
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

ELAPSED=0
MAX_WAIT=5400
while true; do
  READY="$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready' || true)"
  [ "${READY:-0}" -ge 3 ] && break
  if [ "${ELAPSED}" -ge "${MAX_WAIT}" ]; then
    echo "ERROR: timed out waiting for Harvester nodes (${READY:-0}/3 Ready)"
    kubectl get nodes 2>&1 || true
    virsh list --all || true
    exit 1
  fi
  if [ $((ELAPSED % 120)) -eq 0 ]; then
    echo ">>> ${ELAPSED}s elapsed: ${READY:-0}/3 nodes Ready"
  fi
  sleep 20
  ELAPSED=$((ELAPSED + 20))
done
echo ">>> All 3 Harvester nodes Ready."

# webserver-prod (pre-baked, visible from chapter 1 onward) and any VM the
# student places on the prod/service network carry a nodeAffinity requiring
# stage=prod and network.harvesterhci.io/service=true — the latter is
# auto-injected by Harvester's own admission webhook onto any VM using that
# network, not something the student or any script here asks for. None of
# the 3 nodes carry these labels by default, so without this block
# webserver-prod (and chapter 3's algo-trader-01) sit Unschedulable from the
# very start of the lab. Live-confirmed 2026-07-20 via the Unschedulable
# event in the UI.
#
# Deliberately label only harvester1 and harvester2, not harvester3: the
# story needs exactly one non-candidate node so chapter 4 task 3's live
# migration has a real "this node was never in the running" contrast, and so
# scheduling isn't trivially "any node works". harvester3 gets stage=dev
# instead, to mark it as the non-prod node. Idempotent (--overwrite).
echo ">>> Labeling harvester1 + harvester2 for prod-network VM scheduling (harvester3 intentionally excluded) ..."
for NODE in harvester1 harvester2; do
  kubectl label node "${NODE}" stage=prod migration=yes network.harvesterhci.io/service=true storage=prod --overwrite \
    || echo "WARN: failed to label ${NODE} (non-fatal, but prod-network VMs will stay Unschedulable)."
done

echo ">>> Labeling harvester3 as the non-prod node ..."
kubectl label node harvester3 stage=dev storage=dev --overwrite \
  || echo "WARN: failed to label harvester3."

# Set static variables now, no need for Rancher to be up yet.
# RANCHER_TOKEN and the server-url update are deferred to a later chapter's setup
# so the Rancher wait (7-10 min) does not hit the track-level agent timeout.
echo ">>> Waiting for /root/rancher-password (up to 15 minutes)..."
for _ in $(seq 1 90); do
  [ -s /root/rancher-password ] && break
  sleep 10
done
if [ ! -s /root/rancher-password ]; then
  echo "ERROR: /root/rancher-password never appeared."
  exit 1
fi
RANCHER_PASS=$(cat /root/rancher-password)
agent variable set RANCHER_PASSWORD   "$RANCHER_PASS"
agent variable set RANCHER_URL        "https://192.168.122.9:30002"
agent variable set HARVESTER_URL      "https://192.168.122.10"
agent variable set HARVESTER_PASSWORD "$RANCHER_PASS"

# SSH key for virt1 (chapters 03+).
# kvm-host IS the KVM hypervisor, so virbr0 (192.168.122.x) is directly reachable.
if [ ! -f /root/.ssh/id_rsa ]; then
  ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N ""
  chmod 600 /root/.ssh/id_rsa
fi

mkdir -p /root/.ssh
cat >> /root/.ssh/config << 'SSHEOF'

Host virt1
  HostName 192.168.122.50
  User opensuse
  IdentityFile /root/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host virt*
  User opensuse
  IdentityFile /root/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
SSHEOF

sleep 600

echo ">>> Track setup complete."
