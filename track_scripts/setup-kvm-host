#!/bin/bash

set -euo pipefail

LAB_DIR="/root/rodeo-lab"
RODEO=/usr/local/bin/rodeo

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  sleep 2
done

# Start VMs idempotently using virsh directly.
# rodeo start races with libvirt-guests: it detects harvester nodes as "already running"
# but calls virDomainCreate("rancher") just as libvirt-guests finishes booting it.
# virsh start is safe to call on already-running domains — we suppress the error.
echo ">>> Ensuring all KVM VMs are running..."
for VM in harvester1 harvester2 harvester3 rancher; do
  if virsh list --name 2>/dev/null | grep -q "^${VM}$"; then
    echo "  skip (running) ${VM}"
  else
    echo "  starting ${VM}..."
    virsh start "${VM}" 2>/dev/null \
      && echo "  started ${VM}" \
      || echo "  ${VM} start skipped (already running or race — continuing)"
  fi
done

echo ">>> Waiting for Harvester nodes (up to 90 minutes)..."
export KUBECONFIG=/root/.kube/harvester.yaml

ELAPSED=0
MAX_WAIT=5400
until [ "$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready' || echo 0)" -ge 3 ]; do
  sleep 20
  ELAPSED=$((ELAPSED + 20))
  if [[ $ELAPSED -ge $MAX_WAIT ]]; then
    echo "ERROR: Timed out waiting for Harvester nodes"
    virsh list --all
    exit 1
  fi
  if [[ $((ELAPSED % 120)) -eq 0 ]]; then
    READY=$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready' || echo 0)
    echo ">>> ${ELAPSED}s elapsed — ${READY}/3 nodes Ready"
  fi
done
echo ">>> All 3 Harvester nodes Ready"

# Set static variables now — no need for Rancher to be up yet.
# RANCHER_TOKEN and server-url update are deferred to challenge 00's setup
# so that the Rancher wait (7-10 min) doesn't hit the track-level agent timeout.
RANCHER_PASS=$(cat /root/rancher-password)
agent variable set RANCHER_PASSWORD   "$RANCHER_PASS"
agent variable set RANCHER_URL        "https://192.168.122.9:30002"
agent variable set HARVESTER_URL      "https://192.168.122.10"
agent variable set HARVESTER_PASSWORD "$RANCHER_PASS"

# SSH key for virt1 (challenges 03+).
# kvm-host IS the KVM hypervisor — virbr0 (192.168.122.x) is directly reachable.
if [ ! -f /root/.ssh/id_rsa ]; then
  ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N ""
  chmod 600 /root/.ssh/id_rsa
fi

mkdir -p /root/.ssh
cat >> /root/.ssh/config << 'SSHEOF'

Host virt1
  HostName 192.168.122.50
  User opensuse
  IdentityFile /root/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host virt*
  User opensuse
  IdentityFile /root/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
SSHEOF

echo ">>> Track setup complete."
