#!/bin/bash

set -euo pipefail

# The kvm-host image (config.yml) autostarts the nested VMs (harvester1-3 +
# rancher) via libvirt on boot. This script does not start them; it only waits
# for the cluster to come up and exports the agent variables the chapters use.
# Every wait below is a real bounded loop, not a fixed sleep — a new/untested
# image can boot at a different pace than the one this was last tuned for.

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  sleep 2
done

# Serve the boot image chapters 3/4/6 import from, over HTTP on the virbr0
# gateway (192.168.122.1 — this is kvm-host itself, already the gateway
# every nested VM's cloud-init points at, so it's reachable from
# harvester1-3 with no extra networking).
#
# FIXED 2026-07-21: replaced the openSUSE Leap Micro 6.2 appliance
# (openSUSE-Leap-Micro.x86_64-Default-qcow.qcow2) with SLES15-SP7-Minimal-VM
# — Leap Micro's btrfs layout reports a 32GiB virtualSize regardless of the
# ~1.5GB actual download (confirmed via `virt-resize --shrink`: the
# filesystem's own real minimum is ~31.5GiB, not a sparse/shrinkable image),
# which repeatedly exceeded this lab's per-node Longhorn disk capacity
# (FailedAttachVolume/"insufficient storage" on all 3 nodes even at 1
# replica). SLES15-SP7-Minimal-VM follows the same small-cloud-image
# convention as chapter 3's pre-baked SLES-16.0-Minimal-VM (confirmed
# ~1.3GiB virtual size for that one, proven working with a 5Gi PVC).
#
# UNLIKE the openSUSE Leap Micro image, this one has NO stable public
# re-download URL — SLES cloud images are gated behind SUSE Customer Center,
# and dl.suse.com URLs are signed and expire (see the `dlauth=` query string
# on chapter 3's pre-baked SLES-16 image's spec.url for a live example). So
# there is no automatic download here: the file has to be placed at
# ${IMAGE_CACHE_DIR}/${IMAGE_FILE} by hand (as done for this lab) or baked
# into the kvm-host image ahead of time via rodeo-cli. If it's ever missing,
# this script only logs a warning — chapters 3/4/6 image imports will fail
# until someone places the file there.
IMAGE_CACHE_DIR="/var/www/images"
IMAGE_FILE="SLES15-SP7-Minimal-VM.x86_64-Cloud-GM.qcow2"
IMAGE_HTTP_PORT=8889
mkdir -p "${IMAGE_CACHE_DIR}"
if [ ! -s "${IMAGE_CACHE_DIR}/${IMAGE_FILE}" ]; then
  echo ">>> [image-cache] WARNING: ${IMAGE_FILE} not present at ${IMAGE_CACHE_DIR} — chapters 3/4/6 image imports will fail until it is placed there manually (no public re-download URL for this SUSE-licensed image)." >> /var/log/image-cache.log
fi

if ! pgrep -f "http.server ${IMAGE_HTTP_PORT}" &>/dev/null; then
  setsid nohup python3 -m http.server "${IMAGE_HTTP_PORT}" --bind 192.168.122.1 --directory "${IMAGE_CACHE_DIR}" \
    < /dev/null &> /var/log/image-http-server.log &
  disown
fi

echo ">>> Waiting for Harvester VIP (192.168.122.10)..."
until curl -sk --max-time 5 "https://192.168.122.10" &>/dev/null; do
  sleep 5
done
echo ">>> Harvester VIP up."

echo ">>> Waiting for Harvester nodes (up to 90 minutes)..."
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

ELAPSED=0
MAX_WAIT=5400
while true; do
  READY="$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready' || true)"
  [ "${READY:-0}" -ge 3 ] && break
  if [ "${ELAPSED}" -ge "${MAX_WAIT}" ]; then
    echo "ERROR: timed out waiting for Harvester nodes (${READY:-0}/3 Ready)"
    kubectl get nodes 2>&1 || true
    virsh list --all || true
    exit 1
  fi
  if [ $((ELAPSED % 120)) -eq 0 ]; then
    echo ">>> ${ELAPSED}s elapsed: ${READY:-0}/3 nodes Ready"
  fi
  sleep 20
  ELAPSED=$((ELAPSED + 20))
done
echo ">>> All 3 Harvester nodes Ready."

# webserver-prod (pre-baked, visible from chapter 1 onward) and any VM the
# student places on the prod/service network carry a nodeAffinity requiring
# stage=prod and network.harvesterhci.io/service=true — the latter is
# auto-injected by Harvester's own admission webhook onto any VM using that
# network, not something the student or any script here asks for. None of
# the 3 nodes carry these labels by default, so without this block
# webserver-prod (and chapter 3's vertex-trader-01) sit Unschedulable from the
# very start of the lab. Live-confirmed 2026-07-20 via the Unschedulable
# event in the UI.
#
# Deliberately label only harvester1 and harvester2, not harvester3: the
# story needs exactly one non-candidate node so chapter 4 task 3's live
# migration has a real "this node was never in the running" contrast, and so
# scheduling isn't trivially "any node works". harvester3 gets stage=dev
# instead, to mark it as the non-prod node. Idempotent (--overwrite).
echo ">>> Labeling harvester1 + harvester2 for prod-network VM scheduling (harvester3 intentionally excluded) ..."
for NODE in harvester1 harvester2; do
  kubectl label node "${NODE}" stage=prod migration=yes network.harvesterhci.io/service=true storage=prod --overwrite \
    || echo "WARN: failed to label ${NODE} (non-fatal, but prod-network VMs will stay Unschedulable)."
done

echo ">>> Labeling harvester3 as the non-prod node ..."
kubectl label node harvester3 stage=dev storage=dev --overwrite \
  || echo "WARN: failed to label harvester3."

# webserver-prod (pre-baked, visible from chapter 1 onward — it's the VM
# chapter 4's live-migration story assumes is already running) — ensure it's
# started from track start, not just from chapter 4 onward.
#
# FIXED 2026-07-21: moved here from chapter 4's setup-kvm-host, same reason
# as the node labels above — a fresh lab showed webserver-prod Off with "
# Restart action is required for the virtual machine configuration change to
# take effect" as early as chapter 3, since nothing before chapter 4 used to
# touch it. Also now explicitly clears a pending RestartRequired condition
# (delete the VMI so the VM controller recreates it against the current
# spec) before just checking runStrategy — a VM already on runStrategy
# Always will NOT auto-restart itself past a RestartRequired condition, it
# needs an explicit restart, which the original chapter 4 logic never did.
#
# FIXED 2026-07-21: dropped the "wait up to 10 minutes for Running phase"
# loop that used to sit here — webserver-prod isn't touched by any chapter
# until chapter 4's live migration, so there's no reason to block the rest
# of track setup on it. Kick off the restart/start and move on; it has
# plenty of time to come up in the background before it's needed. The
# runStrategy patch below must stay active (not commented out) — without it,
# a webserver-prod that's fully Stopped (not just RestartRequired) never
# gets told to start at all.
echo ">>> Sanity-checking pre-existing production VM webserver-prod ..."
if kubectl get vm -n prod webserver-prod &>/dev/null; then
  RESTART_REQUIRED="$(kubectl get vm -n prod webserver-prod \
    -o jsonpath='{.status.conditions[?(@.type=="RestartRequired")].status}' 2>/dev/null)"
  if [ "${RESTART_REQUIRED}" = "True" ]; then
    echo ">>> webserver-prod has a pending RestartRequired condition — forcing a restart ..."
    kubectl delete vmi -n prod webserver-prod --ignore-not-found --wait=false 2>/dev/null \
      || echo "WARN: failed to delete webserver-prod's VMI for restart."
  fi

  RUN_STRATEGY="$(kubectl get vm -n prod webserver-prod -o jsonpath='{.spec.runStrategy}' 2>/dev/null)"
  if [ "${RUN_STRATEGY}" != "Always" ]; then
    echo ">>> webserver-prod runStrategy is '${RUN_STRATEGY:-unset}', starting it (story requires it Running by chapter 4) ..."
    kubectl patch vm -n prod webserver-prod --type merge -p '{"spec":{"runStrategy":"Always"}}' \
      || echo "WARN: failed to start webserver-prod."
  fi
else
  echo "WARN: webserver-prod NOT found in prod — chapter 4 task 3 will have nothing to migrate."
fi

# Set static variables now, no need for Rancher to be up yet.
# RANCHER_TOKEN and the server-url update are deferred to a later chapter's setup
# so the Rancher wait (7-10 min) does not hit the track-level agent timeout.
echo ">>> Waiting for /root/rancher-password (up to 15 minutes)..."
for _ in $(seq 1 90); do
  [ -s /root/rancher-password ] && break
  sleep 10
done
if [ ! -s /root/rancher-password ]; then
  echo "ERROR: /root/rancher-password never appeared."
  exit 1
fi
RANCHER_PASS=$(cat /root/rancher-password)
agent variable set RANCHER_PASSWORD   "$RANCHER_PASS"
agent variable set RANCHER_URL        "https://192.168.122.9:30002"
agent variable set HARVESTER_URL      "https://192.168.122.10"
agent variable set HARVESTER_PASSWORD "$RANCHER_PASS"

# --- SUSE Virtualization branding -------------------------------------------
# MOVED 2026-07-28: originally sat right after the node-Ready wait, which was
# too early - live-confirmed the settings.management.cattle.io CRD objects
# exist but patches against them silently no-op (WARN, non-fatal) until the
# embedded Rancher management API is actually up, the same ~7-10 min gap the
# RANCHER_PASS wait above already exists to work around. Runs here instead,
# right after HARVESTER_PASSWORD confirms that API is reachable.
# The lab shows raw "Harvester" branding by default. ui-pl (Private Label) is
# a confirmed-real management.cattle.io/v3 Setting - live-verified two ways:
# (1) against Harvester's own source
# (pkg/controller/master/rancher/embedded_rancher.go): its
# RancherSettingOnChange controller resets ui-pl/ui-brand back to
# "Harvester"/"harvester" whenever their .default field differs from that,
# but it never touches .value - so patching .value sticks and survives that
# controller; (2) live in the UI itself - "Private Label" is a real field
# next to the logo that literally shows the raw text "Harvester". Set to
# "Virtualization" (not "SUSE Virtualization") because the logo image itself
# already carries the "SUSE" mark, so logo + private label together read
# "SUSE" + "Virtualization" without repeating "SUSE" twice.
# ui-brand deliberately left alone: no confirmation the UI bundle ships theme
# assets for a non-"harvester"/"rancher" brand key.
#
# ui-theme forces the light/dark theme for every user, pre- and post-login,
# overriding OS/time-of-day auto-detection - confirmed in rancher/dashboard's
# own source (shell/store/prefs.js: `if (setting?.value) { return
# setting?.value; }` short-circuits everything else; shell/config/settings.ts
# documents ui-theme as "Allow the backend to force a light/dark theme. Used
# in non-rancher world" - exactly this lab's case). Both SUSE Virtualization
# and Rancher Prime read the same embedded management.cattle.io Setting
# objects on this cluster, so one patch covers both UIs. Forced to "light"
# since the logo (assets/logos/suse_logo.svg, green-on-transparent) is a
# light-background variant only.
echo ">>> Rebranding UI: ui-pl -> 'Virtualization' ..."
kubectl patch settings.management.cattle.io ui-pl --type merge -p '{"value":"Virtualization"}' \
  || echo "WARN: failed to patch ui-pl (non-fatal, UI will keep showing 'Harvester')."

echo ">>> Forcing UI theme -> light (both SUSE Virtualization and Rancher Prime) ..."
kubectl patch settings.management.cattle.io ui-theme --type merge -p '{"value":"light"}' \
  || echo "WARN: failed to patch ui-theme (non-fatal)."

# assets/logos/suse_logo.svg (horizontal SUSE wordmark, green,
# light-background) in this repo, inlined here as PNG since track_scripts run
# on kvm-host with no access to the git working tree itself. ui-logo-light
# and ui-logo-dark are live-confirmed to exist and render on this cluster
# (tested 2026-07-28 via manual kubectl patch, logo now shows correctly in
# the UI) - the exists-check below is just defensive, not because it's
# still in doubt.
SUSE_LOGO_B64=""

for LOGO_SETTING in ui-logo-light ui-logo-dark; do
  if kubectl get settings.management.cattle.io "${LOGO_SETTING}" &>/dev/null; then
    echo ">>> Rebranding UI: ${LOGO_SETTING} ..."
    kubectl patch settings.management.cattle.io "${LOGO_SETTING}" --type merge \
      -p "{\"value\":\"data:image/png;base64,${SUSE_LOGO_B64}\"}" \
      || echo "WARN: failed to patch ${LOGO_SETTING} (non-fatal)."
  else
    echo ">>> ${LOGO_SETTING} setting not present on this cluster/version, skipping (logo customization may require a custom dashboard build)."
  fi
done

for COLOR_SETTING in ui-primary-color ui-link-color; do
  if kubectl get settings.management.cattle.io "${COLOR_SETTING}" &>/dev/null; then
    echo ">>> Rebranding UI: ${COLOR_SETTING} -> SUSE green (#30ba78) ..."
    kubectl patch settings.management.cattle.io "${COLOR_SETTING}" --type merge -p '{"value":"#30ba78"}' \
      || echo "WARN: failed to patch ${COLOR_SETTING} (non-fatal)."
  else
    echo ">>> ${COLOR_SETTING} setting not present on this cluster/version, skipping."
  fi
done

# SSH key embedded (inline ssh_authorized_keys) into the VMs chapter 4/6
# create themselves: daily-batch-processor (192.168.122.52) and
# core-services (192.168.122.53). kvm-host IS the KVM hypervisor, so
# virbr0 (192.168.122.x) is directly reachable.
#
# FIXED 2026-07-21: removed a "Host virt1" -> 192.168.122.50 entry that used
# to live here, aliased to vertex-trader-01 (chapter 3). It was unfixably
# broken, not just mislabeled: vertex-trader-01 authenticates via the pre-baked
# Harvester KeyPair prod/default (ed25519, see 03-.../solve-kvm-host), not
# via this script-generated RSA key at all - that key was never authorized
# on that VM, so the alias would fail regardless of which username it used.
# No student-facing content ever referenced this alias (repo-wide grep for
# "ssh virt" turned up nothing), so nothing else needed to change.
if [ ! -f /root/.ssh/id_rsa ]; then
  ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N ""
  chmod 600 /root/.ssh/id_rsa
fi

mkdir -p /root/.ssh
cat >> /root/.ssh/config << 'SSHEOF'

Host virt*
  User sles
  IdentityFile /root/.ssh/id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
SSHEOF

sleep 600

echo ">>> Track setup complete."
