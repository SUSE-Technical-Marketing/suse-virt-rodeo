#!/bin/bash
# Challenge 4 setup.
#
# First deletes chapter 3's vertex-trader-01 (self-contained to that chapter,
# nothing later needs it) to free resources on this resource-constrained host,
# before pre-provisioning the "already running in production" VM this
# chapter's story assumes exists before the student arrives:
#   daily-batch-processor   (the VM that gets paused/unpaused)
#
# payment-gateway-prod (the VM that gets live-migrated) is already baked into
# the cluster/image — this script does not touch it, only sanity-checks it's
# there.
#
# daily-batch-processor boots from the SLES15-SP7 Minimal VM image chapter 3,
# task 1 walks the student through adding (official-images/SLES15-SP7-
# Minimal-VM...) — that image is never used by vertex-trader-01, it exists for
# this VM. SSH user is `sles` to match that image's convention (same family
# as the pre-baked SLES-16 image vertex-trader-01 boots from).
#
# FIXED 2026-07-17: this script used to just wait up to 10 minutes for that
# image to exist and silently skip VM creation if it never showed up — which
# is exactly what happens if a chapter (or a presenter running a live
# workshop) skips straight to chapter 4 without chapter 3 ever running. Now
# it self-provisions the same image (matched by URL, not by name) if it's
# missing, so chapter 4 works standalone regardless of chapter 3.
#
# Idempotent (kubectl apply) and non-fatal: a failure here should never block
# the track, but the chapter will be unworkable until this succeeds at least
# once, so watch the Instruqt setup logs on first live run.
#
# Field shapes below are now live-confirmed (2026-07-15) via a real dump of
# the pre-baked production VM on this cluster — see 03-.../solve-kvm-host's
# header for the full breakdown. Corrected here from the original guesses:
#   - Network is prod/service (not prod/vmnet) — matches the pre-baked
#     production VM's actual network, since this VM is also meant to be
#     "already running production" alongside it.
#   - Interface type is `bridge: {}`, not `masquerade: {}`.
#   - evictionStrategy is `LiveMigrateIfPossible`, not `LiveMigrate`.
#   - SSH access: CORRECTED 2026-07-16 — the `harvesterhci.io/sshNames`
#     annotation only works when cloud-init goes through Harvester's own
#     secret-based path (cloudInitNoCloud.secretRef). It is a silent no-op
#     against inline cloudInitNoCloud.userData like this script uses (proven
#     live via vertex-trader-01 in chapter 3: VM came up fine, annotation was
#     present, but no key was ever injected — password prompt on SSH). Back to
#     embedding the track's own SSH public key directly via
#     ssh_authorized_keys in the inline userData.
#   - storageClassName is READ from the image's own status.storageClassName
#     at runtime (it's a per-image generated `lh-<uuid>` value, not something
#     derivable from the image name — the original `longhorn-${IMAGE_NAME}`
#     guess was wrong).
#
# FIXED 2026-07-20/21 then REPLACED 2026-07-21: disk-0's PVC size was 5Gi,
# which failed with "volume size should be larger than the backing image
# size" against the (then) openSUSE Leap Micro image — its btrfs layout
# reports a 32GiB virtualSize no matter the ~1.5GB actual download, and
# `virt-resize --shrink` confirmed the filesystem's own real minimum is
# ~31.5GiB, not a sparse/shrinkable image. Pinning it to 1 replica (instead
# of Harvester's 3-replica default) still weren't enough — the lab's 3 nodes
# didn't have 32GiB+ free each (FailedAttachVolume/"insufficient storage" on
# all 3 nodes, confirmed via Longhorn manager logs). Switched to
# SLES15-SP7-Minimal-VM instead of continuing to fight this image's size —
# same small-cloud-image family as the pre-baked SLES-16 image vertex-trader-01
# already boots from (~1.3GiB virtual size for that one, works fine with a
# 5Gi PVC). disk-0 here is 5Gi accordingly; confirm with `qemu-img info`
# against the actual downloaded file if this ever needs re-verifying. Same
# switch applied to chapter 6's setup-kvm-host (same image, same story).
#
# FIXED 2026-07-17: assignment.md now calls this VM webserver-prod throughout
# (matches the real cluster object). Its Running-on-arrival sanity check
# moved to track_scripts/setup-kvm-host on 2026-07-21 — see that script.
#
# The SLES cloud-image family (confirmed via chapter 3's pre-baked SLES-16
# image and vertex-trader-01) is cloud-init-first and honors NoCloud static
# network-data correctly — the Combustion-vs-cloud-init risk that applied to
# the old Leap Micro image doesn't apply here.

set -uo pipefail
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

NS="prod"
NET="${NS}/service"
IMAGE_NS="official-images"
SSH_PUBKEY_FILE="/root/.ssh/id_rsa.pub"

log(){ echo ">>> [ch4-setup] $*"; }

# Node labels for webserver-prod's nodeAffinity (stage=prod/harvester3
# excluded/network.harvesterhci.io/service=true) now live in
# track_scripts/setup-kvm-host, since webserver-prod is visible from chapter
# 1 onward and needs them from the start of the lab, not just by chapter 4.

log "freeing resources: deleting vertex-trader-01 from chapter 3 (self-contained, nothing later needs it) ..."
if kubectl get vm -n "${NS}" vertex-trader-01 &>/dev/null; then
  kubectl delete vm -n "${NS}" vertex-trader-01 --wait=false 2>/dev/null || true
  kubectl delete pvc -n "${NS}" vertex-trader-01-disk-0 vertex-trader-01-market-data-vol --ignore-not-found --wait=false 2>/dev/null || true
  log "vertex-trader-01 delete requested (non-blocking)."
else
  log "vertex-trader-01 not present, nothing to clean up."
fi

# webserver-prod's runStrategy/RestartRequired sanity-check now lives in
# track_scripts/setup-kvm-host, since it's visible from chapter 1 onward and
# needs to be Running from the start of the lab, not just by chapter 4 (a
# fresh lab showed it Off with a pending "Restart action is required"
# message as early as chapter 3).

# webserver-prod's IP is static (assigned via the pre-baked image's own
# netplan/cloud-init, not by any script here) — always 192.168.122.147.
# Exposed as PAYMENT_GATEWAY_IP for task 2's heartbeat and task 4's uptime
# check, so assignment.md can use it directly instead of a manual lookup.
agent variable set PAYMENT_GATEWAY_IP "192.168.122.147"
log "PAYMENT_GATEWAY_IP=192.168.122.147"

log "waiting for namespace ${NS} ..."
for _ in $(seq 1 60); do
  kubectl get namespace "${NS}" &>/dev/null && break
  sleep 5
done
kubectl get namespace "${NS}" &>/dev/null || { log "warn: namespace ${NS} never appeared (non-fatal, but chapter 4 will fail)."; }

log "waiting for VM network ${NET} ..."
for _ in $(seq 1 60); do
  kubectl get network-attachment-definitions.k8s.cni.cncf.io -n "${NS}" service &>/dev/null && break
  sleep 5
done

log "waiting for SSH keypair ${SSH_PUBKEY_FILE} (generated by track setup) ..."
for _ in $(seq 1 30); do
  [ -f "${SSH_PUBKEY_FILE}" ] && break
  sleep 5
done
if [ ! -f "${SSH_PUBKEY_FILE}" ]; then
  log "warn: no SSH public key found; daily-batch-processor will come up without student SSH access."
  SSH_PUBKEY=""
else
  SSH_PUBKEY="$(cat "${SSH_PUBKEY_FILE}")"
fi

IMAGE_URL="http://192.168.122.1:8889/SLES15-SP7-Minimal-VM.x86_64-Cloud-GM.qcow2"
IMAGE_DISPLAY_NAME="SLES15-SP7-Minimal-VM.x86_64-Cloud-GM.qcow2"

find_image() {
  kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.url}{"\n"}{end}' 2>/dev/null \
    | grep -F "${IMAGE_URL}" | awk '{print $1}' | head -n1
}

log "checking for SLES15-SP7 Minimal VM image in ${IMAGE_NS} ..."
IMAGE_NAME="$(find_image)"

if [ -z "${IMAGE_NAME}" ]; then
  log "not found (chapter 3 task 1 likely skipped) — creating it directly ..."
  cat <<EOF | kubectl create -f -
apiVersion: harvesterhci.io/v1beta1
kind: VirtualMachineImage
metadata:
  generateName: image-
  namespace: ${IMAGE_NS}
spec:
  sourceType: download
  displayName: ${IMAGE_DISPLAY_NAME}
  url: ${IMAGE_URL}
  storageClassParameters:
    numberOfReplicas: "1"
EOF
  sleep 5
  IMAGE_NAME="$(find_image)"
fi

log "waiting for image ${IMAGE_NS}/${IMAGE_NAME:-<pending>} to become Active (up to 10 minutes) ..."
READY=""
for _ in $(seq 1 60); do
  [ -z "${IMAGE_NAME}" ] && IMAGE_NAME="$(find_image)"
  if [ -n "${IMAGE_NAME}" ]; then
    READY="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${IMAGE_NAME}" \
      -o jsonpath='{.status.progress}' 2>/dev/null)"
    [ "${READY}" = "100" ] && break
  fi
  sleep 10
done

if [ -z "${IMAGE_NAME}" ] || [ "${READY:-}" != "100" ]; then
  log "warn: image still not Active after waiting. Skipping VM creation."
  echo ">>> Challenge 4 setup complete (daily-batch-processor NOT created — image not ready)."
  exit 0
fi
log "using image ${IMAGE_NS}/${IMAGE_NAME}"

IMAGE_SC="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${IMAGE_NAME}" \
  -o jsonpath='{.status.storageClassName}' 2>/dev/null)"
[ -n "${IMAGE_SC}" ] || { log "warn: could not read storageClassName for ${IMAGE_NS}/${IMAGE_NAME}; VM creation will likely fail."; }

create_vm() {
  local name="$1" ip="$2" pin_node="${3:-}"

  if kubectl get vm -n "${NS}" "${name}" &>/dev/null; then
    log "${name} already exists, skipping."
    return
  fi

  local affinity_key affinity_value
  if [ -n "${pin_node}" ]; then
    log "creating ${name} at ${ip}, pinned to node ${pin_node} (webserver-prod's current node, for a guaranteed first collision) ..."
    affinity_key="kubernetes.io/hostname"
    affinity_value="${pin_node}"
  else
    log "creating ${name} at ${ip} ..."
    affinity_key="stage"
    affinity_value="prod"
  fi

  cat <<EOF | kubectl apply -f -
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: ${name}
  namespace: ${NS}
  labels:
    stage: prod
  annotations:
    harvesterhci.io/volumeClaimTemplates: |-
      [{"metadata":{"name":"${name}-disk-0","annotations":{"harvesterhci.io/imageId":"${IMAGE_NS}/${IMAGE_NAME}"}},"spec":{"accessModes":["ReadWriteMany"],"resources":{"requests":{"storage":"5Gi"}},"volumeMode":"Block","storageClassName":"${IMAGE_SC}"}}]
spec:
  runStrategy: Always
  template:
    metadata:
      labels:
        harvesterhci.io/vmName: ${name}
    spec:
      hostname: ${name}
      evictionStrategy: LiveMigrateIfPossible
      # Pin to a stage=prod node (harvester1/harvester2 only, set up earlier in
      # this script) — or, on initial creation, to webserver-prod's exact
      # current node (see pin_node below) for a guaranteed first collision.
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: ${affinity_key}
                operator: In
                values:
                - ${affinity_value}
      domain:
        cpu:
          cores: 2
          sockets: 1
          threads: 1
        resources:
          requests:
            cpu: "2"
            memory: 2Gi
          limits:
            cpu: "2"
            memory: 2Gi
        machine:
          type: q35
        devices:
          disks:
          - name: disk-0
            bootOrder: 1
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            model: virtio
            bridge: {}
      networks:
      - name: default
        multus:
          networkName: ${NET}
      volumes:
      - name: disk-0
        persistentVolumeClaim:
          claimName: ${name}-disk-0
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            hostname: ${name}
            ssh_authorized_keys:
              - ${SSH_PUBKEY}
          networkData: |
            version: 2
            ethernets:
              enp1s0:
                addresses:
                  - ${ip}/24
                gateway4: 192.168.122.1
                nameservers:
                  addresses:
                    - 192.168.122.1
EOF
}

# Resolve webserver-prod's current node so daily-batch-processor's FIRST
# placement is guaranteed to collide with it — otherwise the scheduler might
# just as easily pick the other stage=prod node, making chapter 6's
# LastHealthyReplica story a coin flip instead of a reliable demo. Bounded to
# 2 minutes; if it doesn't resolve, daily-batch-processor still schedules
# fine, just without the guaranteed collision (non-fatal).
log "resolving webserver-prod's current node for daily-batch-processor's initial placement ..."
WEBSERVER_NODE=""
for _ in $(seq 1 12); do
  WEBSERVER_NODE="$(kubectl get vmi -n "${NS}" webserver-prod -o jsonpath='{.status.nodeName}' 2>/dev/null)"
  [ -n "${WEBSERVER_NODE}" ] && break
  sleep 10
done
if [ -n "${WEBSERVER_NODE}" ]; then
  log "webserver-prod is on node ${WEBSERVER_NODE}."
else
  log "warn: could not resolve webserver-prod's node after 2 minutes; daily-batch-processor will schedule normally (stage=prod, may or may not collide)."
fi

create_vm "daily-batch-processor" "192.168.122.52" "${WEBSERVER_NODE}"

log "waiting for daily-batch-processor to reach Running phase ..."
for _ in $(seq 1 60); do
  PHASE="$(kubectl get vmi -n "${NS}" daily-batch-processor -o jsonpath='{.status.phase}' 2>/dev/null)"
  [ "${PHASE}" = "Running" ] && { log "daily-batch-processor: Running"; break; }
  sleep 10
done
[ "${PHASE:-}" = "Running" ] || log "warn: daily-batch-processor not Running yet (non-fatal, check the UI)."

# Release the node pin now that placement has happened once — restores the
# normal stage=prod affinity every other prod VM uses, so a future reschedule
# (restart, chapter 6's node drain) isn't artificially forced back onto
# webserver-prod's node forever. requiredDuringSchedulingIgnoredDuringExecution
# only affects scheduling decisions, so this never moves the VM that's
# already running — it only changes what happens on the NEXT reschedule.
# Idempotent and safe to run even if daily-batch-processor already existed
# from a prior run.
log "releasing daily-batch-processor's node pin (back to normal stage=prod scheduling) ..."
kubectl patch vm -n "${NS}" daily-batch-processor --type merge \
  -p '{"spec":{"template":{"spec":{"affinity":{"nodeAffinity":{"requiredDuringSchedulingIgnoredDuringExecution":{"nodeSelectorTerms":[{"matchExpressions":[{"key":"stage","operator":"In","values":["prod"]}]}]}}}}}}}' \
  || log "warn: failed to release daily-batch-processor's node pin."

echo ">>> Challenge 4 setup complete."
exit 0
