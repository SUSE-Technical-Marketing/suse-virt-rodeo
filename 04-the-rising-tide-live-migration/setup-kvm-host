#!/bin/bash
# Challenge 4 setup — pre-provisions the "already running in production" VM
# this chapter's story assumes exists before the student arrives:
#   daily-batch-processor   (the VM that gets paused/unpaused)
#
# payment-gateway-prod (the VM that gets live-migrated) is already baked into
# the cluster/image — this script does not touch it, only sanity-checks it's
# there.
#
# daily-batch-processor boots from the openSUSE Leap Micro image the student
# adds in chapter 3, task 1 (official-images/openSUSE-Leap-Micro...) — that
# image is never used by algo-trader-01, it exists for this VM (and presumably
# was also how payment-gateway-prod was provisioned). SSH user is `opensuse`
# to match that image's convention.
#
# Idempotent (kubectl apply) and non-fatal: a failure here should never block
# the track, but the chapter will be unworkable until this succeeds at least
# once, so watch the Instruqt setup logs on first live run.
#
# KNOWN RISK — not yet verified against a live cluster:
#   1. Whether the openSUSE Leap Micro "Default-qcow" appliance actually honors
#      NoCloud cloud-init (SSH key injection + static network-data). Leap
#      Micro's default appliance is sometimes Combustion-first rather than
#      cloud-init-first — if the VMs come up but SSH/static-IP don't take,
#      this is the first thing to check.
#   2. The harvesterhci.io/volumeClaimTemplates annotation shape below
#      (imageId key, storageClassName pattern, volumeMode) follows Harvester's
#      documented convention but was written without a live cluster to diff
#      against a UI-created VM's exported YAML. If VM creation fails or the
#      disk never attaches, compare this annotation against
#      `kubectl get vm algo-trader-01 -o yaml` (chapter 3) and fix here.

set -uo pipefail
export KUBECONFIG=/root/.kube/harvester.yaml

NS="vertex-trust-prod"
NET="${NS}/vmnet"
IMAGE_NS="official-images"
SSH_PUBKEY_FILE="/root/.ssh/id_rsa.pub"

log(){ echo ">>> [ch4-setup] $*"; }

log "sanity-checking pre-existing payment-gateway-prod ..."
if kubectl get vm -n "${NS}" payment-gateway-prod &>/dev/null; then
  log "payment-gateway-prod found in ${NS}, leaving it alone."
else
  log "warn: payment-gateway-prod NOT found in ${NS} — chapter 4 task 3 will have nothing to migrate. Check where it's baked in (image or another namespace)."
fi

log "waiting for namespace ${NS} ..."
for _ in $(seq 1 60); do
  kubectl get namespace "${NS}" &>/dev/null && break
  sleep 5
done
kubectl get namespace "${NS}" &>/dev/null || { log "warn: namespace ${NS} never appeared (non-fatal, but chapter 4 will fail)."; }

log "waiting for VM network ${NET} ..."
for _ in $(seq 1 60); do
  kubectl get network-attachment-definitions.k8s.cni.cncf.io -n "${NS}" vmnet &>/dev/null && break
  sleep 5
done

log "waiting for SSH keypair ${SSH_PUBKEY_FILE} (generated by track setup) ..."
for _ in $(seq 1 30); do
  [ -f "${SSH_PUBKEY_FILE}" ] && break
  sleep 5
done
if [ ! -f "${SSH_PUBKEY_FILE}" ]; then
  log "warn: no SSH public key found; VMs will come up without student SSH access."
  SSH_PUBKEY=""
else
  SSH_PUBKEY="$(cat "${SSH_PUBKEY_FILE}")"
fi

log "waiting for openSUSE Leap Micro image in ${IMAGE_NS} to become Active ..."
IMAGE_NAME=""
for _ in $(seq 1 60); do
  IMAGE_NAME="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.url}{"\n"}{end}' 2>/dev/null \
    | grep -i 'openSUSE-Leap-Micro' | awk '{print $1}' | head -n1)"
  if [ -n "${IMAGE_NAME}" ]; then
    READY="$(kubectl get virtualmachineimages.harvesterhci.io -n "${IMAGE_NS}" "${IMAGE_NAME}" \
      -o jsonpath='{.status.progress}' 2>/dev/null)"
    [ "${READY}" = "100" ] && break
  fi
  sleep 10
done

if [ -z "${IMAGE_NAME}" ]; then
  log "warn: openSUSE Leap Micro image not found yet (student may not have reached chapter 3 task 1). Skipping VM creation."
  echo ">>> Challenge 4 setup complete (daily-batch-processor NOT created — image missing)."
  exit 0
fi
log "using image ${IMAGE_NS}/${IMAGE_NAME}"

create_vm() {
  local name="$1" ip="$2"

  if kubectl get vm -n "${NS}" "${name}" &>/dev/null; then
    log "${name} already exists, skipping."
    return
  fi

  log "creating ${name} at ${ip} ..."
  cat <<EOF | kubectl apply -f -
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: ${name}
  namespace: ${NS}
  labels:
    stage: prod
  annotations:
    harvesterhci.io/volumeClaimTemplates: |-
      [{"metadata":{"name":"${name}-disk-0","annotations":{"harvesterhci.io/imageId":"${IMAGE_NS}/${IMAGE_NAME}"}},"spec":{"accessModes":["ReadWriteMany"],"resources":{"requests":{"storage":"5Gi"}},"volumeMode":"Block","storageClassName":"longhorn-${IMAGE_NAME}"}}]
spec:
  running: true
  template:
    metadata:
      labels:
        harvesterhci.io/vmName: ${name}
    spec:
      evictionStrategy: LiveMigrate
      domain:
        cpu:
          cores: 2
        resources:
          limits:
            cpu: "2"
            memory: 2Gi
        machine:
          type: q35
        devices:
          disks:
          - name: disk-0
            bootOrder: 1
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            model: virtio
            masquerade: {}
      networks:
      - name: default
        multus:
          networkName: ${NET}
      volumes:
      - name: disk-0
        persistentVolumeClaim:
          claimName: ${name}-disk-0
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            hostname: ${name}
            ssh_authorized_keys:
              - ${SSH_PUBKEY}
          networkData: |
            version: 2
            ethernets:
              enp1s0:
                addresses:
                  - ${ip}/24
                gateway4: 192.168.122.1
                nameservers:
                  addresses:
                    - 192.168.122.1
EOF
}

create_vm "daily-batch-processor" "192.168.122.52"

log "waiting for daily-batch-processor to reach Running phase ..."
for _ in $(seq 1 60); do
  PHASE="$(kubectl get vmi -n "${NS}" daily-batch-processor -o jsonpath='{.status.phase}' 2>/dev/null)"
  [ "${PHASE}" = "Running" ] && { log "daily-batch-processor: Running"; break; }
  sleep 10
done
[ "${PHASE:-}" = "Running" ] || log "warn: daily-batch-processor not Running yet (non-fatal, check the UI)."

echo ">>> Challenge 4 setup complete."
exit 0
