#!/bin/bash
set -euo pipefail
source ~/.bashrc

if [ -f /root/.kube/checkin-cluster.yaml ]; then
  export KUBECONFIG=/root/.kube/checkin-cluster.yaml
  kubectl get nodes 2>/dev/null && echo "checkin-cluster context active." || \
    echo "WARNING: checkin-cluster not reachable. Complete challenge 05 first."
else
  echo "WARNING: checkin-cluster kubeconfig not found. Complete challenge 05 first."
fi
