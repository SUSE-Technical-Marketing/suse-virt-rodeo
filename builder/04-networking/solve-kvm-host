#!/bin/bash

set -euo pipefail

source ~/.bashrc

# --- VLAN 100: ramp control backbone ---
echo ">>> Creating 'vlan100' VM network (VLAN 100 on mgmt cluster network)..."
kubectl apply -f - << 'EOF'
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: vlan100
  namespace: default
  annotations:
    network.harvesterhci.io/clusterNetworkName: mgmt
spec:
  config: '{"cniVersion":"0.3.1","name":"vlan100","type":"bridge","bridge":"mgmt-br","promMode":true,"vlan":100,"ipam":{},"macspoofchk":false,"mtu":1500,"hairpinMode":false}'
EOF

# --- Kube-OVN isolated subnets: airline tenant zones ---
echo ">>> Creating 'containment-alpha' airline isolation zone (SkyWave)..."
kubectl apply -f - << 'EOF'
apiVersion: kubeovn.io/v1
kind: Subnet
metadata:
  name: containment-alpha
spec:
  cidrBlock: "172.16.0.0/24"
  gateway: "172.16.0.1"
  excludeIps:
    - "172.16.0.1"
  protocol: IPv4
  natOutgoing: false
  private: true
EOF

echo ">>> Creating 'containment-beta' airline isolation zone (NordAir)..."
kubectl apply -f - << 'EOF'
apiVersion: kubeovn.io/v1
kind: Subnet
metadata:
  name: containment-beta
spec:
  cidrBlock: "172.16.1.0/24"
  gateway: "172.16.1.1"
  excludeIps:
    - "172.16.1.1"
  protocol: IPv4
  natOutgoing: false
  private: true
EOF

echo ">>> Verifying resources..."
kubectl get network-attachment-definitions vlan100 -n default 2>/dev/null && echo "  vlan100 OK" || echo "  WARNING: vlan100 not found"
kubectl get subnets.kubeovn.io containment-alpha 2>/dev/null && echo "  containment-alpha OK" || echo "  WARNING: containment-alpha not found"
kubectl get subnets.kubeovn.io containment-beta 2>/dev/null && echo "  containment-beta OK" || echo "  WARNING: containment-beta not found"

echo ">>> Challenge 03 solve complete."
