#!/bin/bash
set -euo pipefail
source ~/.bashrc

if ! kubectl get network-attachment-definitions vlan100 -n default &>/dev/null; then
  fail-message "The 'vlan100' ramp control network does not exist. Create it in Networks > VM Networks with VLAN ID 100."
  exit 1
fi

if ! kubectl get subnets.kubeovn.io containment-alpha &>/dev/null; then
  fail-message "The 'containment-alpha' zone does not exist. Run the first kubectl apply command from the assignment."
  exit 1
fi

if ! kubectl get subnets.kubeovn.io containment-beta &>/dev/null; then
  fail-message "The 'containment-beta' zone does not exist. Run the second kubectl apply command from the assignment."
  exit 1
fi

echo "Ramp control VLAN and airline isolation zones verified."
exit 0
