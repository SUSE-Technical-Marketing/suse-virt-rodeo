<network>
  <name>default</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr0' stp='on' delay='0'/>
  <ip address='{{ libvirt_network_gateway }}' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.122.2' end='192.168.122.254'/>
{% for node in vm_nodes %}
      <host mac='{{ node.mgmt_mac }}' name='{{ node.name }}' ip='{{ node.ip }}'/>
{% endfor %}
    </dhcp>
  </ip>
</network>
