#!/bin/bash

set -euo pipefail

export KUBECONFIG=/root/.kube/harvester.yaml

RANCHER_TOKEN=$(agent variable get RANCHER_TOKEN)
RANCHER_PASSWORD=$(agent variable get RANCHER_PASSWORD)
RANCHER_INTERNAL="https://192.168.122.9:30002"

# Use the internal Rancher URL throughout the import so the registration
# manifest URL points to 192.168.122.9:30002, which is directly reachable
# from inside Harvester VMs. The external proxy URL requires hairpin NAT
# (VM → internet → Instruqt → back to same KVM host), which is unreliable.
echo ">>> Setting Rancher server-url to internal for import..."
curl -sk -X PUT \
  -H "Authorization: Bearer $RANCHER_TOKEN" \
  -H "Content-Type: application/json" \
  "${RANCHER_INTERNAL}/v3/settings/server-url" \
  -d "{\"value\": \"${RANCHER_INTERNAL}\"}" >/dev/null

echo ">>> Checking if Harvester cluster is already imported..."
EXISTING=$(curl -sk \
  -H "Authorization: Bearer $RANCHER_TOKEN" \
  "${RANCHER_INTERNAL}/v3/clusters?name=harvester" \
  | jq -r '.data[0].state // empty')

if [ "$EXISTING" != "active" ]; then
  CLUSTER_ID=$(curl -sk \
    -H "Authorization: Bearer $RANCHER_TOKEN" \
    "${RANCHER_INTERNAL}/v3/clusters?name=harvester" \
    | jq -r '.data[0].id // empty')

  if [ -z "$CLUSTER_ID" ]; then
    echo ">>> Creating Harvester import cluster in Rancher..."
    CLUSTER_ID=$(curl -sk -X POST \
      -H "Authorization: Bearer $RANCHER_TOKEN" \
      -H "Content-Type: application/json" \
      "${RANCHER_INTERNAL}/v3/clusters" \
      -d '{"type":"cluster","name":"harvester","annotations":{"field.cattle.io/description":"AeroGrid SUSE Virtualization HCI cluster"}}' \
      | jq -r '.id')
    if [ -z "$CLUSTER_ID" ] || [ "$CLUSTER_ID" = "null" ]; then
      echo "ERROR: Failed to create cluster entry in Rancher"
      exit 1
    fi
    echo ">>> Cluster created: $CLUSTER_ID"
  fi

  echo ">>> Waiting for registration token..."
  MANIFEST_URL=""
  for i in $(seq 1 12); do
    MANIFEST_URL=$(curl -sk \
      -H "Authorization: Bearer $RANCHER_TOKEN" \
      "${RANCHER_INTERNAL}/v3/clusterregistrationtokens?clusterId=${CLUSTER_ID}" \
      | jq -r '.data[0].manifestUrl // empty')
    [ -n "$MANIFEST_URL" ] && break
    sleep 5
  done
  if [ -z "$MANIFEST_URL" ]; then
    echo "ERROR: Could not get registration manifest URL from Rancher"
    exit 1
  fi
  echo ">>> Registration URL: $MANIFEST_URL"

  # kubectl patch is more reliable than the Harvester REST API for settings
  echo ">>> Applying cluster-registration-url to Harvester via kubectl..."
  kubectl patch settings.harvesterhci.io cluster-registration-url \
    --type=merge -p "{\"value\":\"${MANIFEST_URL}\"}"
  echo ">>> cluster-registration-url set."

  echo ">>> Waiting for cluster to become Active (up to 20 minutes)..."
  ACTIVE=false
  for i in $(seq 1 120); do
    STATE=$(curl -sk \
      -H "Authorization: Bearer $RANCHER_TOKEN" \
      "${RANCHER_INTERNAL}/v3/clusters/${CLUSTER_ID}" \
      | jq -r '.state // empty')
    echo "  State: ${STATE} (attempt ${i}/120)"
    if [ "$STATE" = "active" ]; then
      ACTIVE=true
      break
    fi
    sleep 10
  done
  if [ "$ACTIVE" != "true" ]; then
    echo "ERROR: Cluster did not reach Active state within 20 minutes"
    exit 1
  fi
  echo ">>> SUSE Virtualization cluster is Active in Rancher."
fi

# Restore external Rancher URL so student browser tab works correctly
if [ -n "${_SANDBOX_DNS:-}" ]; then
  EXTERNAL_URL="https://kvm-host-30002.${_SANDBOX_DNS}"
  curl -sk -X PUT \
    -H "Authorization: Bearer $RANCHER_TOKEN" \
    -H "Content-Type: application/json" \
    "${RANCHER_INTERNAL}/v3/settings/server-url" \
    -d "{\"value\": \"${EXTERNAL_URL}\"}" >/dev/null
  echo ">>> Rancher server-url restored to external URL."
fi

echo ">>> Challenge 01 solve complete."
