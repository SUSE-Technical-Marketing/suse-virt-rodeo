#!/bin/bash

set -euo pipefail

source ~/.bashrc

RANCHER_PASSWORD=$(agent variable get RANCHER_PASSWORD)

echo ">>> Getting Harvester API token..."
HARV_TOKEN=$(curl -sk -X POST \
  -H "Content-Type: application/json" \
  "https://geekohive:8443/v3-public/localProviders/local?action=login" \
  -d "{\"username\":\"admin\",\"password\":\"${RANCHER_PASSWORD}\",\"ttl\":600000}" \
  | jq -r '.token // empty')

if [ -z "$HARV_TOKEN" ]; then
  echo "ERROR: Failed to get Harvester API token"
  exit 1
fi

# --- ClusterNetwork: vms ---
echo ">>> Creating 'vms' cluster network..."
curl -sk -X POST \
  -H "Authorization: Bearer $HARV_TOKEN" \
  -H "Content-Type: application/json" \
  "https://geekohive:8443/v1/network.harvesterhci.io.clusternetworks" \
  -d '{
    "apiVersion": "network.harvesterhci.io/v1beta1",
    "kind": "ClusterNetwork",
    "metadata": {"name": "vms"},
    "spec": {"enable": true, "mtu": 1500}
  }' > /dev/null || echo "  (vms may already exist)"

# --- NodeNetworkConfig: eth3 on alpha, bravo, charlie ---
for NODE in alpha bravo charlie; do
  echo ">>> Configuring eth3 uplink on node ${NODE}..."
  curl -sk -X POST \
    -H "Authorization: Bearer $HARV_TOKEN" \
    -H "Content-Type: application/json" \
    "https://geekohive:8443/v1/namespaces/harvester-system/network.harvesterhci.io.nodenetworkconfigs" \
    -d "{
      \"apiVersion\": \"network.harvesterhci.io/v1beta1\",
      \"kind\": \"NodeNetworkConfig\",
      \"metadata\": {
        \"name\": \"${NODE}\",
        \"namespace\": \"harvester-system\",
        \"labels\": {\"network.harvesterhci.io/clusternetwork\": \"vms\"}
      },
      \"spec\": {
        \"clusterNetwork\": \"vms\",
        \"uplinks\": {
          \"bondMode\": \"active-backup\",
          \"linkAttributes\": {\"txQueueLen\": -1, \"mtu\": 0},
          \"nics\": [{\"name\": \"eth3\"}]
        }
      }
    }" > /dev/null || echo "  (${NODE} config may already exist)"
done

echo ">>> Waiting 15s for cluster network to initialise..."
sleep 15

# --- VM Network: vmnet ---
echo ">>> Creating 'vmnet' VM network (NetworkAttachmentDefinition)..."
kubectl apply -f - << 'EOF'
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: vmnet
  namespace: default
  annotations:
    network.harvesterhci.io/clusterNetworkName: vms
spec:
  config: '{"cniVersion":"0.3.1","name":"vmnet","type":"bridge","bridge":"vms-br","promMode":true,"vlan":1,"ipam":{},"macspoofchk":false,"mtu":1500,"hairpinMode":false}'
EOF

# --- IP Pool: rodeo-ippool ---
echo ">>> Creating 'rodeo-ippool' LoadBalancer IP pool..."
kubectl apply -f - << 'EOF'
apiVersion: loadbalancer.harvesterhci.io/v1beta1
kind: IPPool
metadata:
  name: rodeo-ippool
  namespace: default
spec:
  ranges:
    - subnet: 192.168.122.0/24
      rangeStart: 192.168.122.200
      rangeEnd: 192.168.122.220
  selector:
    priority: 0
    network: "default/vmnet"
    scope:
      - namespace: default
EOF

echo ">>> Verifying resources..."
kubectl get clusternetworks.network.harvesterhci.io vms 2>/dev/null && echo "  vms cluster network OK" || echo "  WARNING: vms cluster network not found — check ClusterNetwork API"
kubectl get network-attachment-definitions vmnet -n default 2>/dev/null && echo "  vmnet OK" || echo "  WARNING: vmnet not found"
kubectl get ippools.loadbalancer.harvesterhci.io rodeo-ippool -n default 2>/dev/null \
  || kubectl get ippools.network.harvesterhci.io rodeo-ippool -n default 2>/dev/null \
  && echo "  rodeo-ippool OK" || echo "  WARNING: rodeo-ippool not found"

echo ">>> Challenge 01 solve complete."
