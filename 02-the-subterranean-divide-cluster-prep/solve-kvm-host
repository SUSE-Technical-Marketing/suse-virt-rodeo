#!/bin/bash
# Challenge 2 solve — reproduces tasks 2-4 of the-subterranean-divide via the
# Harvester/Kubernetes API instead of the UI. Task 1 is pure UI exploration,
# task 3 is pure inspection (harvester-longhorn already exists) — nothing to
# create for either.
#
# Creates, in order:
#   Task 2 - namespaces prod, dev
#   Task 4 - StorageClass harvester-longhorn-1rep (1 replica, dev cost tier)
#
# Idempotent (kubectl apply). Fails loudly (set -e).
#
# NOTE (2026-07-16): this chapter used to also build the bank's production/dev
# VM networks and an IP Pool (tasks 3-5 in an earlier version). Networking
# moved entirely to chapter 5 — see that chapter for the live-verified
# VlanConfig/NetworkAttachmentDefinition/IPPool shapes if you need them
# ([[reference-harvester-crd-schemas]]).
#
# KNOWN RISK — not yet live-tested:
#   The StorageClass shape below (provisioner driver.longhorn.io, parameters
#   numberOfReplicas/staleReplicaTimeout/migratable) follows Longhorn's
#   well-documented convention and matches the storageClassParameters block
#   Harvester itself sets on every per-image StorageClass (confirmed live via
#   VirtualMachineImage objects — see chapter 3's original solve-kvm-host
#   header, since removed, or the CRD reference memory). Plain StorageClass is
#   a stable core Kubernetes API though, so this is lower-risk than the
#   Harvester-specific CRDs that needed several rounds to get right.

set -euo pipefail
export KUBECONFIG=/root/.kube/harvester.yaml

log(){ echo ">>> [ch2-solve] $*"; }

# --- Task 2: namespaces ---------------------------------------------------
# prod is pre-baked into the cluster image (confirmed live) along with
# prod/service (NAD) and prod/default (KeyPair) — kubectl apply is a safe
# no-op against it. dev is genuinely new.
log "creating namespaces prod, dev ..."
kubectl create namespace prod --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace dev  --dry-run=client -o yaml | kubectl apply -f -

# --- Task 4: dev cost-tier StorageClass -----------------------------------
log "creating StorageClass harvester-longhorn-1rep (1 replica) ..."
cat <<EOF | kubectl apply -f -
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: harvester-longhorn-1rep
provisioner: driver.longhorn.io
allowVolumeExpansion: true
reclaimPolicy: Delete
volumeBindingMode: Immediate
parameters:
  numberOfReplicas: "1"
  staleReplicaTimeout: "30"
  migratable: "true"
EOF

log "verifying harvester-longhorn-1rep exists ..."
kubectl get storageclass harvester-longhorn-1rep &>/dev/null \
  && log "harvester-longhorn-1rep: present" \
  || { echo "ERROR: harvester-longhorn-1rep not found after apply."; exit 1; }

echo "PASS: Chapter 2 objectives created (namespaces prod/dev, harvester-longhorn-1rep StorageClass)"
