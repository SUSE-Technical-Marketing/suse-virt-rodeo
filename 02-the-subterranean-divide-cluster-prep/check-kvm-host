#!/bin/bash
# Challenge 2 check — verifies tasks 2 and 4 of the-subterranean-divide.
# Task 1 is pure UI exploration, task 3 is pure inspection of the pre-existing
# harvester-longhorn StorageClass — nothing to check for either.

set -uo pipefail
export KUBECONFIG=/root/.kube/harvester.yaml

FAIL=0
fail(){ echo "FAIL: $*"; FAIL=1; }

# --- Task 2: namespaces ---------------------------------------------------
for ns in prod dev; do
  kubectl get namespace "${ns}" &>/dev/null || fail "namespace ${ns} not found."
done

# --- Task 4: dev cost-tier StorageClass ------------------------------------
if kubectl get storageclass harvester-longhorn-1rep &>/dev/null; then
  REPLICAS="$(kubectl get storageclass harvester-longhorn-1rep -o jsonpath='{.parameters.numberOfReplicas}' 2>/dev/null)"
  [ "${REPLICAS}" = "1" ] || fail "harvester-longhorn-1rep numberOfReplicas is '${REPLICAS:-empty}', expected 1."
else
  fail "StorageClass harvester-longhorn-1rep not found."
fi

if [[ "${FAIL}" -eq 1 ]]; then
  exit 1
fi

echo "PASS: Chapter 2 objectives verified (namespaces prod/dev, harvester-longhorn-1rep StorageClass)"
