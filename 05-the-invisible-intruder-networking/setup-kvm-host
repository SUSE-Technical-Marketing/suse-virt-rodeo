#!/bin/bash
# Challenge 5 setup.
#
# Deletes chapter 4's daily-batch-processor (self-contained to that chapter —
# nothing in chapters 5-9 references it, confirmed via repo-wide grep) to
# free resources on this resource-constrained host, same pattern chapter 4
# uses to clean up chapter 3's vertex-trader-01.
#
# Its boot disk is 40Gi (see chapter 4's setup-kvm-host header — the Leap
# Micro image's backing/virtual size is 32Gi, so the PVC has to be at least
# that large), tripled by that image's own StorageClass to 3 replicas — the
# single biggest storage consumer among the self-contained per-chapter VMs,
# so freeing it here matters more than vertex-trader-01 did.
#
# Idempotent and non-fatal: a failure here should never block the track.

set -uo pipefail
export KUBECONFIG=/root/.rodeo/harvester-kubeconfig

NS="prod"

log(){ echo ">>> [ch5-setup] $*"; }

log "freeing resources: deleting daily-batch-processor from chapter 4 (self-contained, nothing later needs it) ..."
if kubectl get vm -n "${NS}" daily-batch-processor &>/dev/null; then
  kubectl delete vm -n "${NS}" daily-batch-processor --wait=false 2>/dev/null || true
  kubectl delete pvc -n "${NS}" daily-batch-processor-disk-0 --ignore-not-found --wait=false 2>/dev/null || true
  log "daily-batch-processor delete requested (non-blocking)."
else
  log "daily-batch-processor not present, nothing to clean up."
fi

echo ">>> Challenge 5 setup complete."
exit 0
